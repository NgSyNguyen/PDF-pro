<Project>

  <!-- Central NuGet version management. Every new package must be listed in THIRD_PARTY_NOTICES.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Application -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <!-- Drag and drop in the page organizer. BSD-3-Clause. -->
    <PackageVersion Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <!-- PDF engines -->
  <ItemGroup>
    <!-- PDFium bindings + native binaries (bblanchon/pdfium-binaries). Apache-2.0. -->
    <PackageVersion Include="PDFiumCore" Version="157.0.8100" />
    <!--
      PDFsharp: 6.2.4 is the LAST MIT-licensed release. 6.5.0 and later are AGPL-3.0, which AGENTS.md forbids.
      Never upgrade beyond 6.2.x (a test in PdfPro.Operations.Tests guards this).
    -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- Text with coordinates (UglyToad/PdfPig). Apache-2.0. Tests only in Phase 5; search and redaction from Phase 6. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <!-- Transitive pins (security fixes for dependencies of the packages above) -->
  <ItemGroup>
    <!-- PDFsharp 6.2.4 brings 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform (opted in via global.json); no VSTest packages needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- UI automation of the built app (tests/PdfPro.App.UiTests, run by hand only). MIT. -->
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
