<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line front end (pdfpro.exe). Shares Operations with the app, never references WPF. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PdfPro.Cli</RootNamespace>
    <AssemblyName>pdfpro</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- pdfpro also runs on Linux servers (and its tests in Linux containers): Skia's native library for Linux. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPro.Infrastructure\PdfPro.Infrastructure.csproj" />
    <ProjectReference Include="..\PdfPro.Ocr\PdfPro.Ocr.csproj" />
    <ProjectReference Include="..\PdfPro.Operations\PdfPro.Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\CliStrings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)CliStrings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PdfPro.Cli.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CliStrings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
