<Project Sdk="Microsoft.NET.Sdk">

  <!-- PDF operations (IPdfOperation implementations) and the page plan materializer. -->
  <PropertyGroup>
    <RootNamespace>PdfPro.Operations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned at 6.2.4 in Directory.Packages.props: 6.5+ is AGPL (LicenseGuardTests). -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPro.Core\PdfPro.Core.csproj" />
    <ProjectReference Include="..\PdfPro.Pdfium\PdfPro.Pdfium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noto Sans (SIL OFL 1.1, assets/fonts/NotoSans/OFL.txt): the Vietnamese-capable font of text PDF_Pro writes. -->
    <EmbeddedResource Include="..\..\assets\fonts\NotoSans\NotoSans-Regular.ttf" LogicalName="PdfPro.Fonts.NotoSans-Regular.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\NotoSans\NotoSans-Bold.ttf" LogicalName="PdfPro.Fonts.NotoSans-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfPro.Operations.Tests" />
  </ItemGroup>

</Project>
