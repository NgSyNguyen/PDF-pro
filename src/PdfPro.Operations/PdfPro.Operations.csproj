<Project Sdk="Microsoft.NET.Sdk">

  <!-- PDF operations (IPdfOperation implementations) and the page plan materializer. -->
  <PropertyGroup>
    <RootNamespace>PdfPro.Operations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned at 6.2.4 in Directory.Packages.props: 6.5+ is AGPL (LicenseGuardTests). -->
    <PackageReference Include="PDFsharp" />
    <!-- Apache-2.0: an extractor independent of PDFium, for the mandatory check after a redaction (SPEC P8 B). -->
    <PackageReference Include="PdfPig" />
    <!-- Digital signatures (CMS, RFC 3161 timestamps): used directly since Phase 8. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPro.Core\PdfPro.Core.csproj" />
    <ProjectReference Include="..\PdfPro.Pdfium\PdfPro.Pdfium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts (SIL OFL 1.1, assets/fonts/*/OFL.txt): the Vietnamese-capable fonts of text PDF_Pro writes. -->
    <EmbeddedResource Include="..\..\assets\fonts\NotoSans\*.ttf;..\..\assets\fonts\NotoSerif\*.ttf;..\..\assets\fonts\BeVietnamPro\*.ttf" LogicalName="PdfPro.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfPro.Operations.Tests" />
  </ItemGroup>

</Project>
