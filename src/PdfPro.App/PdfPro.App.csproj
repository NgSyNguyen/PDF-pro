<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the notification area icon (NotifyIcon); its namespaces are not imported globally. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 asks Windows Forms apps to set DPI awareness in code; this is a WPF app, its manifest sets it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>PdfPro.App</RootNamespace>
    <AssemblyName>PdfPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon of PdfPro.exe: its windows, the taskbar, the notification area, shortcuts and "Open with" use it. -->
    <ApplicationIcon>..\..\assets\icon\PdfPro.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>PdfPro.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="gong-wpf-dragdrop" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPro.Infrastructure\PdfPro.Infrastructure.csproj" />
    <ProjectReference Include="..\PdfPro.Operations\PdfPro.Operations.csproj" />
    <ProjectReference Include="..\PdfPro.Ocr\PdfPro.Ocr.csproj" />
    <!-- The licenses, shown in "Giới thiệu" and shipped next to PdfPro.exe. -->
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**\*" LinkBase="licenses" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- PdfPro.Worker.exe goes next to PdfPro.exe; the app only starts it (no types are used). -->
    <ProjectReference Include="..\PdfPro.Worker\PdfPro.Worker.csproj" />
  </ItemGroup>

  <!-- UI strings: Strings.resx is Vietnamese (neutral), Strings.en.resx is English. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>PdfPro.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    WPF compiles a temporary assembly (markup pass 1) before the normal resource generation runs, so the
    strongly typed Strings class would not exist yet. Generate it first and hand it to the temporary build.
  -->
  <Target
    Name="PdfProGenerateStringsBeforeMarkupCompile"
    BeforeTargets="GenerateTemporaryTargetAssembly"
    DependsOnTargets="PrepareResourceNames;ResGen">
    <ItemGroup>
      <_GeneratedCodeFiles Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>

  <!-- Handwriting fonts for signatures typed by name (SIL OFL 1.1, assets/fonts/*/OFL.txt): drawn into the signature picture. -->
  <ItemGroup>
    <Content Include="..\..\assets\fonts\DancingScript\DancingScript-Regular.otf" Link="Fonts\DancingScript-Regular.otf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\Charm\Charm-Regular.ttf" Link="Fonts\Charm-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\DancingScript\OFL.txt" Link="Fonts\DancingScript-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\Charm\OFL.txt" Link="Fonts\Charm-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- External tools fetched by tools/fetch-tools.ps1 (never committed) go next to the executable, in tools\. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\qpdf\bin\qpdf.exe')">
    <Content Include="..\..\tools\qpdf\**\*" LinkBase="tools\qpdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\tesseract\tesseract.exe')">
    <Content Include="..\..\tools\tesseract\**\*" LinkBase="tools\tesseract" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfPro.App.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
