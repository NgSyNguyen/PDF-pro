<ui:FluentWindow
  x:Class="PdfPro.App.Views.BookmarksEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dd="urn:gong-wpf-dragdrop"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:structure="clr-namespace:PdfPro.App.ViewModels.Structure"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=structure:BookmarksEditorViewModel}"
  Title="{loc:Tr Bookmarks_Title}"
  Width="900"
  Height="640"
  MinWidth="720"
  MinHeight="480"
  AutomationProperties.AutomationId="BookmarksEditorWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Tr Bookmarks_Title}" ShowMinimize="False" />

    <WrapPanel Grid.Row="1" Margin="24,4,24,8">
      <ui:Button
        Margin="0,0,6,0"
        AutomationProperties.AutomationId="BookmarksAdd"
        Command="{Binding AddCommand}"
        Content="{loc:Tr Bookmarks_Add}"
        Icon="{ui:SymbolIcon Add24}" />
      <ui:Button
        Margin="0,0,6,0"
        AutomationProperties.AutomationId="BookmarksAddChild"
        Command="{Binding AddChildCommand}"
        Content="{loc:Tr Bookmarks_AddChild}" />
      <ui:Button
        Margin="0,0,6,0"
        AutomationProperties.AutomationId="BookmarksRemove"
        Command="{Binding RemoveCommand}"
        Content="{loc:Tr Bookmarks_Remove}"
        Icon="{ui:SymbolIcon Delete24}" />
      <ui:Button
        Margin="12,0,6,0"
        AutomationProperties.AutomationId="BookmarksMoveUp"
        AutomationProperties.Name="{loc:Tr Bookmarks_MoveUp}"
        Command="{Binding MoveUpCommand}"
        Icon="{ui:SymbolIcon ArrowUp24}"
        ToolTip="{loc:Tr Bookmarks_MoveUp}" />
      <ui:Button
        Margin="0,0,6,0"
        AutomationProperties.AutomationId="BookmarksMoveDown"
        AutomationProperties.Name="{loc:Tr Bookmarks_MoveDown}"
        Command="{Binding MoveDownCommand}"
        Icon="{ui:SymbolIcon ArrowDown24}"
        ToolTip="{loc:Tr Bookmarks_MoveDown}" />
      <ui:Button
        Margin="0,0,6,0"
        AutomationProperties.AutomationId="BookmarksOutdent"
        Command="{Binding OutdentCommand}"
        Content="{loc:Tr Bookmarks_Outdent}" />
      <ui:Button
        AutomationProperties.AutomationId="BookmarksIndent"
        Command="{Binding IndentCommand}"
        Content="{loc:Tr Bookmarks_Indent}" />
    </WrapPanel>

    <Grid Grid.Row="2" Margin="24,0,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>
      <Border
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <TreeView
          dd:DragDrop.DropHandler="{Binding}"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          AutomationProperties.AutomationId="BookmarksTree"
          AutomationProperties.Name="{loc:Tr Bookmarks_Title}"
          ItemsSource="{Binding Items}"
          SelectedItemChanged="OnSelectedItemChanged">
          <TreeView.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type structure:BookmarkItemViewModel}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Bold}" Value="True">
                          <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Italic}" Value="True">
                          <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock
                  Margin="8,0,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding PageText}" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <ScrollViewer
        Grid.Column="2"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <StackPanel IsEnabled="{Binding HasSelection}">
            <TextBlock
              Margin="0,0,0,4"
              Style="{StaticResource FieldLabel}"
              Text="{loc:Tr Bookmarks_TitleLabel}" />
            <TextBox
              AutomationProperties.AutomationId="BookmarksTitle"
              AutomationProperties.Name="{loc:Tr Bookmarks_TitleLabel}"
              Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bookmarks_Page}" />
            <TextBox
              Width="80"
              HorizontalAlignment="Left"
              AutomationProperties.AutomationId="BookmarksPage"
              AutomationProperties.Name="{loc:Tr Bookmarks_Page}"
              Text="{Binding SelectedPageText, UpdateSourceTrigger=LostFocus}" />
            <WrapPanel Margin="0,10,0,0">
              <CheckBox
                Margin="0,0,16,0"
                AutomationProperties.AutomationId="BookmarksBold"
                Content="{loc:Tr Bookmarks_Bold}"
                IsChecked="{Binding Selected.Bold}" />
              <CheckBox
                AutomationProperties.AutomationId="BookmarksItalic"
                Content="{loc:Tr Bookmarks_Italic}"
                IsChecked="{Binding Selected.Italic}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bookmarks_Color}" />
            <ComboBox
              AutomationProperties.AutomationId="BookmarksColor"
              AutomationProperties.Name="{loc:Tr Bookmarks_Color}"
              DisplayMemberPath="Label"
              ItemsSource="{Binding Colors}"
              SelectedValue="{Binding Selected.Color}"
              SelectedValuePath="Value" />
          </StackPanel>

          <Separator Margin="0,16,0,8" />
          <TextBlock FontWeight="SemiBold" Text="{loc:Tr Bookmarks_Generate_Title}" />
          <RadioButton
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="BookmarksBySize"
            Content="{loc:Tr Bookmarks_BySize}"
            GroupName="BookmarkRule"
            IsChecked="{Binding BySize}" />
          <RadioButton
            Margin="0,4,0,0"
            AutomationProperties.AutomationId="BookmarksByPattern"
            Content="{loc:Tr Bookmarks_ByPattern}"
            GroupName="BookmarkRule"
            IsChecked="{Binding ByPattern}" />
          <TextBox
            MinHeight="72"
            Margin="0,6,0,0"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="BookmarksPatterns"
            AutomationProperties.Name="{loc:Tr Bookmarks_ByPattern}"
            FontFamily="Consolas"
            Text="{Binding PatternsText, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap"
            Visibility="{Binding ByPattern, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="BookmarksGenerate"
            Command="{Binding GenerateCommand}"
            Content="{loc:Tr Bookmarks_Generate}"
            Icon="{ui:SymbolIcon Wand24}" />
          <TextBlock
            Margin="0,6,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Bookmarks_Generate_Note}"
            TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="3" Margin="24,12,24,24">
      <TextBlock
        AutomationProperties.AutomationId="BookmarksStatus"
        Text="{Binding StatusText}"
        TextWrapping="Wrap"
        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock
        AutomationProperties.AutomationId="BookmarksError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <StackPanel
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="BookmarksApply"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr Bookmarks_Apply}" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="BookmarksCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
