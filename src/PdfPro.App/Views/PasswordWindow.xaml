<ui:FluentWindow
  x:Class="PdfPro.App.Views.PasswordWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  Title="{loc:Tr Password_Title}"
  Width="460"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr Password_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon
          Margin="0,0,12,0"
          VerticalAlignment="Top"
          FontSize="28"
          Symbol="LockClosed24" />
        <TextBlock
          x:Name="MessageText"
          MaxWidth="360"
          VerticalAlignment="Center"
          TextWrapping="Wrap" />
      </StackPanel>

      <ui:InfoBar
        x:Name="RetryInfo"
        Title="{loc:Tr Password_Wrong}"
        Margin="0,12,0,0"
        IsClosable="False"
        IsOpen="False"
        Severity="Error" />

      <TextBlock Margin="0,16,0,4" Text="{loc:Tr Password_Label}" />
      <ui:PasswordBox
        x:Name="PasswordInput"
        AutomationProperties.AutomationId="PasswordInput"
        AutomationProperties.Name="{loc:Tr Password_Label}" />

      <StackPanel
        Margin="0,20,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="PasswordOpen"
          Click="OnOpenClick"
          Content="{loc:Tr Password_Open}"
          IsDefault="True" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="PasswordCancel"
          Content="{loc:Tr Common_Cancel}"
          IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
