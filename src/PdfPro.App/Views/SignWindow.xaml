<ui:FluentWindow
  x:Class="PdfPro.App.Views.SignWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:security="clr-namespace:PdfPro.App.ViewModels.Security"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=security:SignDialogViewModel}"
  Title="{loc:Tr Sign_Title}"
  Width="580"
  MinHeight="0"
  AutomationProperties.AutomationId="SignWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr Sign_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <TextBlock
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Sign_Intro}"
        TextWrapping="Wrap" />

      <!-- The certificate: the Windows store (smart cards and tokens included) or a .pfx file. -->
      <TextBlock
        Margin="0,16,0,0"
        FontWeight="SemiBold"
        Text="{loc:Tr Sign_Certificate}" />
      <RadioButton
        Margin="0,6,0,0"
        AutomationProperties.AutomationId="SignFromStore"
        Content="{loc:Tr Sign_FromStore}"
        GroupName="SignCertificate"
        IsChecked="{Binding UseStore}"
        IsEnabled="{Binding HasStoreCertificates}" />
      <ComboBox
        Margin="28,6,0,0"
        AutomationProperties.AutomationId="SignStoreCertificate"
        AutomationProperties.Name="{loc:Tr Sign_FromStore}"
        DisplayMemberPath="Label"
        IsEnabled="{Binding UseStore}"
        ItemsSource="{Binding Certificates}"
        SelectedItem="{Binding SelectedCertificate}"
        Visibility="{Binding HasStoreCertificates, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock
        Margin="28,2,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Sign_NoCertificates}"
        TextWrapping="Wrap"
        Visibility="{Binding HasNoStoreCertificates, Converter={StaticResource BoolToVisibility}}" />
      <RadioButton
        Margin="0,10,0,0"
        AutomationProperties.AutomationId="SignFromFile"
        Content="{loc:Tr Sign_FromFile}"
        GroupName="SignCertificate"
        IsChecked="{Binding UseFile}" />
      <Grid Margin="28,6,0,0" IsEnabled="{Binding UseFile}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TextBox
          AutomationProperties.AutomationId="SignPfxPath"
          AutomationProperties.Name="{loc:Tr Sign_FromFile}"
          Text="{Binding PfxPath, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button
          Grid.Column="2"
          AutomationProperties.AutomationId="SignBrowse"
          Command="{Binding BrowseCommand}"
          Content="{loc:Tr Sign_Browse}" />
        <ui:PasswordBox
          x:Name="PfxPasswordInput"
          Grid.Row="2"
          Grid.ColumnSpan="3"
          AutomationProperties.AutomationId="SignPfxPassword"
          AutomationProperties.Name="{loc:Tr Sign_PfxPassword}"
          PasswordChanged="OnPfxPasswordChanged"
          PlaceholderText="{loc:Tr Sign_PfxPassword}" />
      </Grid>

      <!-- Where it goes. -->
      <TextBlock
        Margin="0,16,0,0"
        FontWeight="SemiBold"
        Text="{loc:Tr Sign_Placement}" />
      <ComboBox
        Margin="0,6,0,0"
        AutomationProperties.AutomationId="SignPlacement"
        AutomationProperties.Name="{loc:Tr Sign_Placement}"
        DisplayMemberPath="Label"
        ItemsSource="{Binding Placements}"
        SelectedItem="{Binding SelectedPlacement}" />

      <!-- What a visible signature shows. -->
      <TextBlock
        Margin="0,16,0,0"
        FontWeight="SemiBold"
        Text="{loc:Tr Sign_Appearance}" />
      <StackPanel IsEnabled="{Binding IsVisible}">
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <CheckBox
            AutomationProperties.AutomationId="SignShowImage"
            Content="{loc:Tr Sign_ShowImage}"
            IsChecked="{Binding ShowImage}"
            IsEnabled="{Binding HasImages}" />
          <ComboBox
            Grid.Column="2"
            AutomationProperties.AutomationId="SignImage"
            AutomationProperties.Name="{loc:Tr Sign_ShowImage}"
            DisplayMemberPath="Label"
            IsEnabled="{Binding ShowImage}"
            ItemsSource="{Binding Images}"
            SelectedItem="{Binding SelectedImage}" />
        </Grid>
        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
          <CheckBox
            Margin="0,0,24,0"
            AutomationProperties.AutomationId="SignShowName"
            Content="{loc:Tr Sign_ShowName}"
            IsChecked="{Binding ShowName}" />
          <CheckBox
            AutomationProperties.AutomationId="SignShowDate"
            Content="{loc:Tr Sign_ShowDate}"
            IsChecked="{Binding ShowDate}" />
        </StackPanel>
      </StackPanel>

      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="6" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{loc:Tr Sign_Reason}" />
        <ui:TextBox
          Grid.Column="2"
          AutomationProperties.AutomationId="SignReason"
          AutomationProperties.Name="{loc:Tr Sign_Reason}"
          MaxLength="200"
          Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
          Grid.Row="2"
          VerticalAlignment="Center"
          Text="{loc:Tr Sign_Location}" />
        <ui:TextBox
          Grid.Row="2"
          Grid.Column="2"
          AutomationProperties.AutomationId="SignLocation"
          AutomationProperties.Name="{loc:Tr Sign_Location}"
          MaxLength="200"
          Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
          Grid.Row="4"
          VerticalAlignment="Center"
          Text="{loc:Tr Sign_Contact}" />
        <ui:TextBox
          Grid.Row="4"
          Grid.Column="2"
          AutomationProperties.AutomationId="SignContact"
          AutomationProperties.Name="{loc:Tr Sign_Contact}"
          MaxLength="200"
          Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>

      <!-- The timestamp (RFC 3161). -->
      <CheckBox
        Margin="0,16,0,0"
        AutomationProperties.AutomationId="SignUseTimestamp"
        Content="{loc:Tr Sign_Timestamp}"
        IsChecked="{Binding UseTimestamp}" />
      <ui:TextBox
        Margin="28,6,0,0"
        AutomationProperties.AutomationId="SignTimestampServer"
        AutomationProperties.Name="{loc:Tr Sign_TimestampServer}"
        IsEnabled="{Binding UseTimestamp}"
        PlaceholderText="{loc:Tr Sign_TimestampServer}"
        Text="{Binding TimestampServer, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="SignError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding Error}"
        TextWrapping="Wrap"
        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel
        Margin="0,20,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="SignOk"
          Command="{Binding SignCommand}"
          Content="{loc:Tr Sign_Apply}"
          Icon="{ui:SymbolIcon Certificate24}"
          IsDefault="True" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="SignCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
