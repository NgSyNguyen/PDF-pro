<ui:FluentWindow
  x:Class="PdfPro.App.Views.PageLabelsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:structure="clr-namespace:PdfPro.App.ViewModels.Structure"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=structure:PageLabelsViewModel}"
  Title="{loc:Tr Labels_Title}"
  Width="680"
  Height="520"
  MinWidth="560"
  MinHeight="380"
  AutomationProperties.AutomationId="PageLabelsWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar
      Title="{loc:Tr Labels_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />
    <StackPanel Grid.Row="1" Margin="24,4,24,8">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Margin="0,4,0,8"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Labels_Note}"
        TextWrapping="Wrap" />
      <WrapPanel>
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.AutomationId="LabelsAdd"
          Command="{Binding AddRangeCommand}"
          Content="{loc:Tr Labels_Add}"
          Icon="{ui:SymbolIcon Add24}" />
        <ui:Button
          AutomationProperties.AutomationId="LabelsRemove"
          Command="{Binding RemoveCommand}"
          Content="{loc:Tr Bookmarks_Remove}"
          Icon="{ui:SymbolIcon Delete24}" />
      </WrapPanel>
    </StackPanel>

    <ListBox
      Grid.Row="2"
      Margin="24,0,24,0"
      AutomationProperties.AutomationId="LabelsList"
      AutomationProperties.Name="{loc:Tr Labels_Title}"
      ItemsSource="{Binding Ranges}"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type structure:PageLabelRangeViewModel}">
          <WrapPanel Margin="0,4">
            <TextBlock
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Text="{loc:Tr Labels_From}" />
            <TextBox
              Width="56"
              Margin="0,0,12,0"
              AutomationProperties.Name="{loc:Tr Labels_From}"
              Text="{Binding FirstPageText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
              MinWidth="120"
              Margin="0,0,12,0"
              AutomationProperties.Name="{loc:Tr Labels_Style}"
              DisplayMemberPath="Label"
              ItemsSource="{Binding DataContext.Styles, RelativeSource={RelativeSource AncestorType=ListBox}}"
              SelectedValue="{Binding Style}"
              SelectedValuePath="Value" />
            <TextBlock
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Text="{loc:Tr Labels_Prefix}" />
            <TextBox
              Width="80"
              Margin="0,0,12,0"
              AutomationProperties.Name="{loc:Tr Labels_Prefix}"
              Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Text="{loc:Tr Labels_Start}" />
            <TextBox
              Width="56"
              AutomationProperties.Name="{loc:Tr Labels_Start}"
              Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
          </WrapPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Margin="24,12,24,24">
      <TextBlock
        AutomationProperties.AutomationId="LabelsPreview"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding PreviewText}"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,4,0,0"
        AutomationProperties.AutomationId="LabelsError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <StackPanel
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="LabelsApply"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr Bookmarks_Apply}" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="LabelsCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
