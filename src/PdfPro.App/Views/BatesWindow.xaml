<ui:FluentWindow
  x:Class="PdfPro.App.Views.BatesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:dd="urn:gong-wpf-dragdrop"
  xmlns:editing="clr-namespace:PdfPro.App.ViewModels.Editing"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=editing:BatesViewModel}"
  Title="{loc:Tr Bates_Title}"
  Width="1000"
  Height="700"
  MinWidth="780"
  MinHeight="520"
  AutomationProperties.AutomationId="BatesWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <DataTemplate x:Key="SwatchTemplate" DataType="{x:Type editing:ColorSwatch}">
      <Button
        Width="22"
        Height="22"
        Margin="0,0,4,4"
        Padding="0"
        AutomationProperties.Name="{Binding Hex}"
        Background="{Binding Hex, Converter={StaticResource HexBrush}}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding Hex}"
        ToolTip="{Binding Hex}" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="SwatchPanel">
      <WrapPanel />
    </ItemsPanelTemplate>
  </ui:FluentWindow.Resources>

  <DockPanel>
    <ui:TitleBar
      Title="{loc:Tr Bates_Title}"
      DockPanel.Dock="Top"
      ShowMinimize="False" />

    <!-- Output folder and buttons -->
    <Border
      Padding="24,12,24,20"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0"
      DockPanel.Dock="Bottom">
      <StackPanel>
        <DockPanel>
          <TextBlock
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="{loc:Tr Bates_Output_Label}" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="BatesPickFolder"
            Command="{Binding PickFolderCommand}"
            Content="{loc:Tr Merge_Output_Pick}"
            DockPanel.Dock="Right" />
          <TextBox
            AutomationProperties.AutomationId="BatesOutput"
            AutomationProperties.Name="{loc:Tr Bates_Output_Label}"
            Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
          <CheckBox
            AutomationProperties.AutomationId="BatesOverwrite"
            Content="{loc:Tr Bates_Overwrite}"
            DockPanel.Dock="Left"
            IsChecked="{Binding Overwrite}" />
          <CheckBox
            Margin="16,0,0,0"
            AutomationProperties.AutomationId="BatesOpenFolder"
            Content="{loc:Tr Split_OpenFolder}"
            DockPanel.Dock="Left"
            IsChecked="{Binding OpenFolderWhenDone}" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="BatesCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Common_Cancel}"
            DockPanel.Dock="Right" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="BatesRun"
            Command="{Binding RunCommand}"
            Content="{loc:Tr Bates_Run}"
            DockPanel.Dock="Right"
            IsDefault="True" />
          <TextBlock
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="BatesSummary"
            DockPanel.Dock="Right"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid Margin="24,4,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <!-- The files -->
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            FontWeight="SemiBold"
            Text="{loc:Tr Bates_Files_Header}"
            TextTrimming="CharacterEllipsis" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="BatesSortByName"
            Command="{Binding SortByNameCommand}"
            Content="{loc:Tr Merge_SortByName}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon TextSortAscending24}" />
          <ui:Button
            Appearance="Primary"
            AutomationProperties.AutomationId="BatesAddFiles"
            Command="{Binding AddFilesCommand}"
            Content="{loc:Tr Merge_AddFiles}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon Add24}" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="BatesError"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Text="{Binding ErrorText}"
            TextWrapping="Wrap"
            Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="BatesWarning"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding WarningText}"
            TextWrapping="Wrap"
            Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Style="{StaticResource Note}" Text="{loc:Tr Bates_Note}" />
        </StackPanel>

        <Grid
          Margin="8,10,8,4"
          DockPanel.Dock="Top"
          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="112" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Tr Merge_Column_File}" />
          <TextBlock Grid.Column="1" Text="{loc:Tr Bates_Column_Numbers}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ListBox
          dd:DragDrop.DropHandler="{Binding}"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          AllowDrop="True"
          AutomationProperties.AutomationId="BatesFiles"
          AutomationProperties.Name="{loc:Tr Bates_Files_Header}"
          HorizontalContentAlignment="Stretch"
          ItemsSource="{Binding Items}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type editing:BatesItemViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding File.Path}" />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding PageCountText}" />
                </StackPanel>
                <TextBlock
                  Grid.Column="1"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="BatesItemNumbers"
                  Text="{Binding NumbersText}"
                  TextTrimming="CharacterEllipsis" />
                <StackPanel
                  Grid.Column="2"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveUp}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowUp24}"
                    ToolTip="{loc:Tr Merge_MoveUp}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveDown}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowDown24}"
                    ToolTip="{loc:Tr Merge_MoveDown}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.AutomationId="BatesItemRemove"
                    AutomationProperties.Name="{loc:Tr Merge_Remove}"
                    BorderThickness="0"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{loc:Tr Merge_Remove}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- The label -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="{loc:Tr Bates_Label_Header}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bates_Prefix}" />
              <TextBox
                AutomationProperties.AutomationId="BatesPrefix"
                AutomationProperties.Name="{loc:Tr Bates_Prefix}"
                Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bates_Suffix}" />
              <TextBox
                AutomationProperties.AutomationId="BatesSuffix"
                AutomationProperties.Name="{loc:Tr Bates_Suffix}"
                Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bates_Digits}" />
              <TextBox
                AutomationProperties.AutomationId="BatesDigits"
                AutomationProperties.Name="{loc:Tr Bates_Digits}"
                Text="{Binding Digits, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bates_StartNumber}" />
              <TextBox
                AutomationProperties.AutomationId="BatesStartNumber"
                AutomationProperties.Name="{loc:Tr Bates_StartNumber}"
                Text="{Binding StartNumber, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Bates_Sample}" />
          <Border
            Padding="10,6"
            HorizontalAlignment="Left"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock
              AutomationProperties.AutomationId="BatesSample"
              FontFamily="Consolas"
              Text="{Binding SampleText}" />
          </Border>
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Stamp_Position}" />
          <ComboBox
            AutomationProperties.AutomationId="BatesPosition"
            AutomationProperties.Name="{loc:Tr Stamp_Position}"
            DisplayMemberPath="Label"
            ItemsSource="{Binding Anchors}"
            SelectedValue="{Binding Anchor}"
            SelectedValuePath="Value" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Stamp_Font}" />
              <ComboBox
                AutomationProperties.AutomationId="BatesFont"
                AutomationProperties.Name="{loc:Tr Stamp_Font}"
                ItemsSource="{Binding FontNames}"
                SelectedItem="{Binding FontFamily}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Stamp_FontSize}" />
              <TextBox
                AutomationProperties.AutomationId="BatesFontSize"
                AutomationProperties.Name="{loc:Tr Stamp_FontSize}"
                Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Grid>
          <CheckBox
            Margin="0,10,0,0"
            AutomationProperties.AutomationId="BatesBold"
            Content="{loc:Tr Stamp_Bold}"
            IsChecked="{Binding Bold}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Stamp_Color}" />
          <ItemsControl
            ItemTemplate="{StaticResource SwatchTemplate}"
            ItemsPanel="{StaticResource SwatchPanel}"
            ItemsSource="{Binding Swatches}"
            Tag="{Binding SetColorCommand}" />
          <TextBox
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="BatesColor"
            AutomationProperties.Name="{loc:Tr Stamp_HexColor}"
            Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{loc:Tr Stamp_HexColor}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
