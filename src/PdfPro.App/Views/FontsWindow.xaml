<ui:FluentWindow
  x:Class="PdfPro.App.Views.FontsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:extracting="clr-namespace:PdfPro.App.ViewModels.Extracting"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=extracting:FontsViewModel}"
  Title="{loc:Tr Fonts_Title}"
  Width="860"
  Height="560"
  MinWidth="640"
  MinHeight="400"
  AutomationProperties.AutomationId="FontsWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar
      Title="{loc:Tr Fonts_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,4,24,8">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />
      <TextBlock
        Margin="0,6,0,0"
        AutomationProperties.AutomationId="FontsSummary"
        Text="{Binding SummaryText}"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,4,0,0"
        Foreground="{DynamicResource SystemFillColorCautionBrush}"
        Text="{loc:Tr Fonts_NotEmbedded_Advice}"
        TextWrapping="Wrap"
        Visibility="{Binding HasNotEmbedded, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock
        Margin="0,4,0,0"
        AutomationProperties.AutomationId="FontsError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="24,0,24,0">
      <DataGrid
        AutoGenerateColumns="False"
        AutomationProperties.AutomationId="FontsList"
        AutomationProperties.Name="{loc:Tr Fonts_Title}"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        HeadersVisibility="Column"
        IsReadOnly="True"
        ItemsSource="{Binding Fonts}">
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNotEmbedded}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="2*"
            Binding="{Binding Name}"
            Header="{loc:Tr Fonts_Name}" />
          <DataGridTextColumn
            Width="*"
            Binding="{Binding EmbeddingText}"
            Header="{loc:Tr Fonts_Embedding}" />
          <DataGridTextColumn
            Width="*"
            Binding="{Binding Type}"
            Header="{loc:Tr Fonts_Type}" />
          <DataGridTextColumn
            Width="*"
            Binding="{Binding Encoding}"
            Header="{loc:Tr Fonts_Encoding}" />
          <DataGridTextColumn
            Width="Auto"
            Binding="{Binding UnicodeText}"
            Header="{loc:Tr Fonts_Unicode}" />
          <DataGridTextColumn
            Width="*"
            Binding="{Binding PagesText}"
            Header="{loc:Tr Fonts_Pages}" />
        </DataGrid.Columns>
      </DataGrid>
      <ui:ProgressRing
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsIndeterminate="True"
        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel
      Grid.Row="3"
      Margin="24,12,24,24"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <ui:Button
        MinWidth="96"
        AutomationProperties.AutomationId="FontsClose"
        Command="{Binding CloseCommand}"
        Content="{loc:Tr Common_Close}"
        IsDefault="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
