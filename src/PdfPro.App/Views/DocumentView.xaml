<UserControl
  x:Class="PdfPro.App.Views.DocumentView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:controls="clr-namespace:PdfPro.App.Controls"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  xmlns:viewer="clr-namespace:PdfPro.App.ViewModels.Viewer"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:DocumentTabViewModel}"
  d:DesignHeight="600"
  d:DesignWidth="800">
  <UserControl.Resources>
    <DropShadowEffect
      x:Key="PageShadow"
      BlurRadius="10"
      Direction="270"
      Opacity="0.25"
      RenderingBias="Performance"
      ShadowDepth="1" />

    <DataTemplate x:Key="PageTemplate" DataType="{x:Type viewer:PageViewModel}">
      <Grid AutomationProperties.Name="{Binding AutomationName}">
        <Border Background="White" Effect="{StaticResource PageShadow}" />
        <!-- Until a render with the page's rotation arrives, the previous image (or upright thumbnail) is turned here. -->
        <Image
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="{Binding Image}"
          Stretch="Fill">
          <Image.LayoutTransform>
            <RotateTransform Angle="{Binding ImageAngle}" />
          </Image.LayoutTransform>
        </Image>
        <Canvas ClipToBounds="True">
          <Image
            Canvas.Left="{Binding DetailBounds.X}"
            Canvas.Top="{Binding DetailBounds.Y}"
            Width="{Binding DetailBounds.Width}"
            Height="{Binding DetailBounds.Height}"
            Source="{Binding DetailImage}"
            Stretch="Fill" />
        </Canvas>
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="{Binding RenderFailed, Converter={StaticResource BoolToVisibility}}">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            FontSize="32"
            Foreground="Gray"
            Symbol="DocumentError24" />
          <TextBlock
            Margin="0,6,0,0"
            Foreground="Gray"
            Text="{loc:Tr Viewer_PageRenderFailed}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
        <!-- Search matches and selected text; only draws, the mouse goes to the viewer. -->
        <controls:TextHighlightLayer
          PageKey="{Binding Key}"
          Search="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Selection="{Binding DataContext.TextSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <!-- Annotations added in the session (the page image does not have them yet); only draws. -->
        <controls:AnnotationLayer Annotations="{Binding DataContext.Annotations, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
        <!-- The page editor's objects, selection and guides; inactive (and transparent to the mouse) outside the editor. -->
        <controls:OverlayLayer Editor="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
      </Grid>
    </DataTemplate>

    <Style x:Key="EditorToolButton" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="GroupName" Value="EditorTools" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <ui:InfoBar
      Margin="0,0,0,6"
      AutomationProperties.AutomationId="ReadOnlyNotice"
      DockPanel.Dock="Top"
      IsClosable="False"
      IsOpen="{Binding IsReadOnly}"
      Message="{loc:Tr Document_ReadOnlyEncrypted}"
      Severity="Informational"
      Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />

    <!-- "Sắp xếp trang": the organizer grid replaces the viewer. -->
    <views:OrganizerView Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVisibility}}" />

    <!-- The page editor's bar: tools, then apply / done / cancel. -->
    <Border
      Margin="0,0,0,6"
      Padding="8,6"
      AutomationProperties.AutomationId="EditorBar"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      DataContext="{Binding Editor}"
      DockPanel.Dock="Top"
      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="EditorDelete"
            Command="{Binding DeleteCommand}"
            Content="{loc:Tr Editor_Delete}"
            Icon="{ui:SymbolIcon Delete24}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="EditorCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Editor_Cancel}" />
          <ui:Button
            Margin="0,0,6,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="EditorApply"
            Command="{Binding ApplyCommand}"
            Content="{loc:Tr Editor_Apply}"
            ToolTip="{loc:Tr Editor_Apply_ToolTip}" />
          <ui:Button
            AutomationProperties.AutomationId="EditorDone"
            Command="{Binding DataContext.FinishEditingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Content="{loc:Tr Editor_Done}"
            ToolTip="{loc:Tr Editor_Done_ToolTip}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Select"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Select}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Select}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Select}">
            <ui:SymbolIcon Symbol="Cursor24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Text"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Text}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Text}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Text}">
            <ui:SymbolIcon Symbol="TextAddT24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Rectangle"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Rectangle}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Rectangle}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Rectangle}">
            <ui:SymbolIcon Symbol="RectangleLandscape24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Ellipse"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Ellipse}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Ellipse}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Ellipse}">
            <ui:SymbolIcon Symbol="Circle24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Line"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Line}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Line}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Line}">
            <ui:SymbolIcon Symbol="Line24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Arrow"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Arrow}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Arrow}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Arrow}">
            <ui:SymbolIcon Symbol="ArrowRight24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Whiteout"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Whiteout}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Whiteout}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Whiteout_ToolTip}">
            <ui:SymbolIcon Symbol="Eraser24" />
          </RadioButton>
          <Button
            Margin="0,0,4,0"
            Padding="8,4"
            AutomationProperties.AutomationId="EditorImage"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Image}"
            Command="{Binding DataContext.AddImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ToolTip="{loc:Tr Editor_Tool_Image}">
            <ui:SymbolIcon Symbol="ImageAdd24" />
          </Button>
          <Button
            Margin="0,0,4,0"
            Padding="8,4"
            AutomationProperties.AutomationId="EditorSignature"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Signature}"
            Command="{Binding DataContext.AddSignatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ToolTip="{loc:Tr Editor_Tool_Signature}">
            <ui:SymbolIcon Symbol="Signature24" />
          </Button>
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Editor_Hint}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{loc:Tr Editor_Hint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- An annotation tool is on: which one, and "Xong" to turn it off. -->
    <Border
      Margin="0,0,0,6"
      Padding="8,6"
      AutomationProperties.AutomationId="AnnotationToolBar"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      DataContext="{Binding Annotations}"
      DockPanel.Dock="Top"
      Visibility="{Binding IsToolActive, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <ui:Button
          AutomationProperties.AutomationId="AnnotationToolDone"
          Command="{Binding StopToolCommand}"
          Content="{loc:Tr Annotation_Done}"
          DockPanel.Dock="Right" />
        <TextBlock
          VerticalAlignment="Center"
          Text="{Binding ToolText}"
          TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- The comment of a note: opens where it was clicked; clicking elsewhere keeps what was written. -->
    <Popup
      x:Name="ContentsPopup"
      AllowsTransparency="True"
      Closed="OnContentsPopupClosed"
      DataContext="{Binding Annotations}"
      IsOpen="{Binding IsEditingContents, Mode=OneWay}"
      Opened="OnContentsPopupOpened"
      Placement="MousePoint"
      StaysOpen="False">
      <Border
        Padding="10"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel Width="280">
          <TextBlock
            Margin="0,0,0,6"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ContentsHeader}"
            TextTrimming="CharacterEllipsis" />
          <TextBox
            x:Name="ContentsBox"
            MinHeight="80"
            MaxHeight="240"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="AnnotationContents"
            AutomationProperties.Name="{loc:Tr Annotation_Contents_Name}"
            PreviewKeyDown="OnContentsKeyDown"
            Text="{Binding ContentsDraft, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
          <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
              Margin="0,0,6,0"
              Command="{Binding CancelContentsCommand}"
              Content="{loc:Tr Common_Cancel}" />
            <ui:Button
              Appearance="Primary"
              AutomationProperties.AutomationId="AnnotationContentsDone"
              Command="{Binding CommitContentsCommand}"
              Content="{loc:Tr Annotation_Done}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <ScrollViewer
      x:Name="Scroller"
      AutomationProperties.AutomationId="DocumentScroller"
      AutomationProperties.Name="{Binding Title}"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      CanContentScroll="True"
      DataContext="{Binding Viewer}"
      Focusable="True"
      FocusVisualStyle="{x:Null}"
      HorizontalScrollBarVisibility="Auto"
      PreviewKeyDown="OnPreviewKeyDown"
      PreviewMouseDown="OnPreviewMouseDown"
      PreviewMouseWheel="OnPreviewMouseWheel"
      VerticalScrollBarVisibility="Visible"
      Visibility="{Binding DataContext.IsOrganizing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:DocumentViewPanel
        x:Name="Surface"
        AutomationProperties.AutomationId="DocumentSurface"
        Background="Transparent"
        DpiScale="{Binding DpiScale, Mode=TwoWay}"
        MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
        MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
        MouseMove="OnSurfaceMouseMove"
        Offset="{Binding ScrollOffset, Mode=TwoWay}"
        PageLayout="{Binding Layout}"
        PageTemplate="{StaticResource PageTemplate}"
        Pages="{Binding Pages}"
        ViewportSize="{Binding ViewportSize, Mode=TwoWay}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
