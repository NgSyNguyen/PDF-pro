<UserControl
  x:Class="PdfPro.App.Views.DocumentView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:controls="clr-namespace:PdfPro.App.Controls"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  xmlns:viewer="clr-namespace:PdfPro.App.ViewModels.Viewer"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:DocumentTabViewModel}"
  d:DesignHeight="600"
  d:DesignWidth="800">
  <UserControl.Resources>
    <DropShadowEffect
      x:Key="PageShadow"
      BlurRadius="10"
      Direction="270"
      Opacity="0.25"
      RenderingBias="Performance"
      ShadowDepth="1" />

    <DataTemplate x:Key="PageTemplate" DataType="{x:Type viewer:PageViewModel}">
      <Grid AutomationProperties.Name="{Binding AutomationName}">
        <Border Background="White" Effect="{StaticResource PageShadow}" />
        <!-- Until a render with the page's rotation arrives, the previous image (or upright thumbnail) is turned here. -->
        <Image
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="{Binding Image}"
          Stretch="Fill">
          <Image.LayoutTransform>
            <RotateTransform Angle="{Binding ImageAngle}" />
          </Image.LayoutTransform>
        </Image>
        <Canvas ClipToBounds="True">
          <Image
            Canvas.Left="{Binding DetailBounds.X}"
            Canvas.Top="{Binding DetailBounds.Y}"
            Width="{Binding DetailBounds.Width}"
            Height="{Binding DetailBounds.Height}"
            Source="{Binding DetailImage}"
            Stretch="Fill" />
        </Canvas>
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Visibility="{Binding RenderFailed, Converter={StaticResource BoolToVisibility}}">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            FontSize="32"
            Foreground="Gray"
            Symbol="DocumentError24" />
          <TextBlock
            Margin="0,6,0,0"
            Foreground="Gray"
            Text="{loc:Tr Viewer_PageRenderFailed}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
        <!-- Search matches and selected text; only draws, the mouse goes to the viewer. -->
        <controls:TextHighlightLayer
          PageKey="{Binding Key}"
          Search="{Binding DataContext.Search, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Selection="{Binding DataContext.TextSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <!-- The form's fields: real inputs over their widgets, showing the session's values. -->
        <controls:FormFieldLayer Forms="{Binding DataContext.Forms, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
        <!-- Annotations added in the session (the page image does not have them yet); only draws. -->
        <controls:AnnotationLayer Annotations="{Binding DataContext.Annotations, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
        <!-- "Sửa nội dung": frames around the drawing under the mouse and the selected one; only draws. -->
        <controls:ContentObjectLayer Editor="{Binding DataContext.ContentEditor, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
        <!-- The page editor's objects, selection and guides; inactive (and transparent to the mouse) outside the editor. -->
        <controls:OverlayLayer Editor="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType=UserControl}}" PageKey="{Binding Key}" />
      </Grid>
    </DataTemplate>

    <Style x:Key="EditorToolButton" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="GroupName" Value="EditorTools" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <ui:InfoBar
      Margin="0,0,0,6"
      AutomationProperties.AutomationId="ReadOnlyNotice"
      DockPanel.Dock="Top"
      IsClosable="False"
      IsOpen="{Binding IsReadOnly}"
      Message="{loc:Tr Document_ReadOnlyEncrypted}"
      Severity="Informational"
      Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />

    <ui:InfoBar
      Margin="0,0,0,6"
      AutomationProperties.AutomationId="XfaNotice"
      DockPanel.Dock="Top"
      IsClosable="False"
      IsOpen="{Binding Forms.HasXfaNotice, Mode=OneWay}"
      Message="{Binding Forms.XfaNotice}"
      Severity="Warning"
      Visibility="{Binding Forms.HasXfaNotice, Converter={StaticResource BoolToVisibility}}" />

    <!-- "Sắp xếp trang": the organizer grid replaces the viewer. -->
    <views:OrganizerView Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVisibility}}" />

    <!-- The page editor's bar: tools, then apply / done / cancel. -->
    <Border
      Margin="0,0,0,6"
      Padding="8,6"
      AutomationProperties.AutomationId="EditorBar"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      DataContext="{Binding Editor}"
      DockPanel.Dock="Top"
      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="EditorDelete"
            Command="{Binding DeleteCommand}"
            Content="{loc:Tr Editor_Delete}"
            Icon="{ui:SymbolIcon Delete24}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="EditorCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Editor_Cancel}" />
          <ui:Button
            Margin="0,0,6,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="EditorApply"
            Command="{Binding ApplyCommand}"
            Content="{loc:Tr Editor_Apply}"
            ToolTip="{loc:Tr Editor_Apply_ToolTip}" />
          <ui:Button
            AutomationProperties.AutomationId="EditorDone"
            Command="{Binding DataContext.FinishEditingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Content="{loc:Tr Editor_Done}"
            ToolTip="{loc:Tr Editor_Done_ToolTip}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Select"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Select}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Select}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Select}">
            <ui:SymbolIcon Symbol="Cursor24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Text"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Text}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Text}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Text}">
            <ui:SymbolIcon Symbol="TextAddT24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Rectangle"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Rectangle}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Rectangle}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Rectangle}">
            <ui:SymbolIcon Symbol="RectangleLandscape24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Ellipse"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Ellipse}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Ellipse}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Ellipse}">
            <ui:SymbolIcon Symbol="Circle24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Line"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Line}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Line}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Line}">
            <ui:SymbolIcon Symbol="Line24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Arrow"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Arrow}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Arrow}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Arrow}">
            <ui:SymbolIcon Symbol="ArrowRight24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="EditorTool_Whiteout"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Whiteout}"
            IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Whiteout}"
            Style="{StaticResource EditorToolButton}"
            ToolTip="{loc:Tr Editor_Tool_Whiteout_ToolTip}">
            <ui:SymbolIcon Symbol="Eraser24" />
          </RadioButton>
          <Button
            Margin="0,0,4,0"
            Padding="8,4"
            AutomationProperties.AutomationId="EditorImage"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Image}"
            Command="{Binding DataContext.AddImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ToolTip="{loc:Tr Editor_Tool_Image}">
            <ui:SymbolIcon Symbol="ImageAdd24" />
          </Button>
          <Button
            Margin="0,0,4,0"
            Padding="8,4"
            AutomationProperties.AutomationId="EditorSignature"
            AutomationProperties.Name="{loc:Tr Editor_Tool_Signature}"
            Command="{Binding DataContext.AddSignatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ToolTip="{loc:Tr Editor_Tool_Signature}">
            <ui:SymbolIcon Symbol="Signature24" />
          </Button>
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Editor_Hint}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{loc:Tr Editor_Hint}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Annotating: the tools, colour and width, stamp words; the selected annotation's comment and delete; "Xong". -->
    <Border
      Margin="0,0,0,6"
      Padding="8,6"
      AutomationProperties.AutomationId="AnnotationToolBar"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      DataContext="{Binding Annotations}"
      DockPanel.Dock="Top"
      Visibility="{Binding IsBarVisible, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ui:Button
              Margin="0,0,6,0"
              AutomationProperties.AutomationId="AnnotationComment"
              Command="{Binding EditCommentCommand}"
              Content="{loc:Tr Annotation_Comment}"
              Icon="{ui:SymbolIcon Comment24}"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
              Margin="0,0,6,0"
              AutomationProperties.AutomationId="AnnotationDelete"
              Command="{Binding DeleteCommand}"
              Content="{loc:Tr Annotation_Delete}"
              Icon="{ui:SymbolIcon Delete24}"
              Visibility="{Binding HasAnySelection, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
              AutomationProperties.AutomationId="AnnotationToolDone"
              Command="{Binding StopToolCommand}"
              Content="{loc:Tr Annotation_Done}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_None"
              AutomationProperties.Name="{loc:Tr Annotation_Tool_None}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=None}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Annotation_Tool_None}">
              <ui:SymbolIcon Symbol="Cursor24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Highlight"
              AutomationProperties.Name="{loc:Tr Cmd_Highlight}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Highlight}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Cmd_Highlight}">
              <ui:SymbolIcon Symbol="Highlight24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Note"
              AutomationProperties.Name="{loc:Tr Cmd_StickyNote}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Note}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Cmd_StickyNote}">
              <ui:SymbolIcon Symbol="Note24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_FreeText"
              AutomationProperties.Name="{loc:Tr Cmd_TextBox}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=FreeText}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Cmd_TextBox}">
              <ui:SymbolIcon Symbol="Textbox24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Ink"
              AutomationProperties.Name="{loc:Tr Cmd_Ink}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Ink}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Cmd_Ink}">
              <ui:SymbolIcon Symbol="InkStroke24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Rectangle"
              AutomationProperties.Name="{loc:Tr Editor_Tool_Rectangle}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Rectangle}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Editor_Tool_Rectangle}">
              <ui:SymbolIcon Symbol="RectangleLandscape24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Ellipse"
              AutomationProperties.Name="{loc:Tr Editor_Tool_Ellipse}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Ellipse}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Editor_Tool_Ellipse}">
              <ui:SymbolIcon Symbol="Circle24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Line"
              AutomationProperties.Name="{loc:Tr Editor_Tool_Line}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Line}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Editor_Tool_Line}">
              <ui:SymbolIcon Symbol="Line24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Arrow"
              AutomationProperties.Name="{loc:Tr Editor_Tool_Arrow}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Arrow}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Editor_Tool_Arrow}">
              <ui:SymbolIcon Symbol="ArrowRight24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Polygon"
              AutomationProperties.Name="{loc:Tr Annotation_Tool_Polygon}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Polygon}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Annotation_Tool_Polygon}">
              <ui:SymbolIcon Symbol="Triangle24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Polyline"
              AutomationProperties.Name="{loc:Tr Annotation_Tool_Polyline}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Polyline}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Annotation_Tool_Polyline}">
              <ui:SymbolIcon Symbol="Pen24" />
            </RadioButton>
            <RadioButton
              AutomationProperties.AutomationId="AnnotationTool_Stamp"
              AutomationProperties.Name="{loc:Tr Cmd_StampAnnotation}"
              GroupName="AnnotationTools"
              IsChecked="{Binding Tool, Converter={StaticResource EnumMatch}, ConverterParameter=Stamp}"
              Style="{StaticResource EditorToolButton}"
              ToolTip="{loc:Tr Cmd_StampAnnotation}">
              <ui:SymbolIcon Symbol="DocumentCheckmark24" />
            </RadioButton>
            <TextBlock
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding ToolText}"
              TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
          <ItemsControl
            VerticalAlignment="Center"
            ItemsSource="{Binding Swatches}"
            Tag="{Binding SetColorCommand}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  Width="20"
                  Height="20"
                  Margin="0,0,4,0"
                  Padding="0"
                  AutomationProperties.Name="{Binding Hex}"
                  Background="{Binding Hex, Converter={StaticResource HexBrush}}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding Hex}"
                  ToolTip="{Binding Hex}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel
            Margin="12,0,0,0"
            Orientation="Horizontal"
            Visibility="{Binding HasWidth, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Text="{loc:Tr Annotation_Width}" />
            <ComboBox
              MinWidth="70"
              AutomationProperties.AutomationId="AnnotationWidth"
              AutomationProperties.Name="{loc:Tr Annotation_Width}"
              ItemsSource="{Binding StrokeWidths}"
              SelectedItem="{Binding StrokeWidth}" />
          </StackPanel>
          <StackPanel
            Margin="12,0,0,0"
            Orientation="Horizontal"
            Visibility="{Binding Tool, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Stamp}">
            <ComboBox
              MinWidth="160"
              AutomationProperties.AutomationId="AnnotationStampText"
              AutomationProperties.Name="{loc:Tr Annotation_StampText}"
              IsEditable="True"
              ItemsSource="{Binding StampTexts}"
              Text="{Binding StampText, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
              Margin="10,0,0,0"
              AutomationProperties.AutomationId="AnnotationStampDate"
              Content="{loc:Tr Annotation_StampWithDate}"
              IsChecked="{Binding StampWithDate}" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- "Sửa nội dung": what is selected and what can be done to it; "Xong" leaves the mode. -->
    <Border
      Margin="0,0,0,6"
      Padding="8,6"
      AutomationProperties.AutomationId="ContentEditorBar"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="4"
      DataContext="{Binding ContentEditor}"
      DockPanel.Dock="Top"
      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentEditText"
            Command="{Binding EditTextCommand}"
            Content="{loc:Tr ContentEditor_EditText}"
            Icon="{ui:SymbolIcon TextEditStyle24}"
            Visibility="{Binding IsTextSelected, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentReplaceImage"
            Command="{Binding ReplaceImageCommand}"
            Content="{loc:Tr ContentEditor_ReplaceImage}"
            Icon="{ui:SymbolIcon ImageEdit24}"
            Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentSaveImage"
            Command="{Binding SaveImageCommand}"
            Content="{loc:Tr ContentEditor_SaveImage}"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentRotateLeft"
            AutomationProperties.Name="{loc:Tr ContentEditor_RotateLeft}"
            Command="{Binding RotateLeftCommand}"
            Icon="{ui:SymbolIcon ArrowRotateCounterclockwise24}"
            ToolTip="{loc:Tr ContentEditor_RotateLeft}"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentRotateRight"
            AutomationProperties.Name="{loc:Tr ContentEditor_RotateRight}"
            Command="{Binding RotateRightCommand}"
            Icon="{ui:SymbolIcon ArrowRotateClockwise24}"
            ToolTip="{loc:Tr ContentEditor_RotateRight}"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            Margin="0,0,6,0"
            AutomationProperties.AutomationId="ContentDelete"
            Command="{Binding DeleteCommand}"
            Content="{loc:Tr ContentEditor_Delete}"
            Icon="{ui:SymbolIcon Delete24}"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button
            AutomationProperties.AutomationId="ContentDone"
            Command="{Binding DataContext.ToggleContentEditingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Content="{loc:Tr ContentEditor_Done}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ui:SymbolIcon Margin="0,0,8,0" Symbol="DocumentEdit24" />
          <TextBlock
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ContentSelection"
            FontWeight="SemiBold"
            Text="{Binding SelectionText}"
            TextTrimming="CharacterEllipsis"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr ContentEditor_Hint}"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The words of a text block, typed over it; clicking elsewhere keeps what was typed. -->
    <Popup
      x:Name="ContentTextPopup"
      AllowsTransparency="True"
      Closed="OnContentTextPopupClosed"
      DataContext="{Binding ContentEditor}"
      HorizontalOffset="{Binding TextBox.X}"
      IsOpen="{Binding IsEditingText, Mode=OneWay}"
      Opened="OnContentTextPopupOpened"
      Placement="Relative"
      PlacementTarget="{Binding ElementName=Surface}"
      StaysOpen="False"
      VerticalOffset="{Binding TextBox.Y}">
      <Border
        Padding="8"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel MinWidth="{Binding TextBox.Width}" MaxWidth="640">
          <TextBox
            x:Name="ContentTextBox"
            MinWidth="220"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="ContentTextBox"
            AutomationProperties.Name="{loc:Tr ContentEditor_TextBox_Name}"
            PreviewKeyDown="OnContentTextKeyDown"
            Text="{Binding TextDraft, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" />
          <CheckBox
            Margin="0,6,0,0"
            AutomationProperties.AutomationId="ContentTextWrap"
            Content="{loc:Tr ContentEditor_Wrap}"
            IsChecked="{Binding WrapText}" />
          <TextBlock
            Margin="0,4,0,0"
            MaxWidth="420"
            HorizontalAlignment="Left"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr ContentEditor_TextLimit}"
            TextWrapping="Wrap" />
          <StackPanel
            Margin="0,6,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
              Margin="0,0,6,0"
              Command="{Binding CancelTextCommand}"
              Content="{loc:Tr Common_Cancel}" />
            <ui:Button
              Appearance="Primary"
              AutomationProperties.AutomationId="ContentTextDone"
              Command="{Binding CommitTextCommand}"
              Content="{loc:Tr ContentEditor_Done}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- The comment of a note: opens where it was clicked; clicking elsewhere keeps what was written. -->
    <Popup
      x:Name="ContentsPopup"
      AllowsTransparency="True"
      Closed="OnContentsPopupClosed"
      DataContext="{Binding Annotations}"
      IsOpen="{Binding IsEditingContents, Mode=OneWay}"
      Opened="OnContentsPopupOpened"
      Placement="MousePoint"
      StaysOpen="False">
      <Border
        Padding="10"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel Width="280">
          <TextBlock
            Margin="0,0,0,6"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ContentsHeader}"
            TextTrimming="CharacterEllipsis" />
          <TextBox
            x:Name="ContentsBox"
            MinHeight="80"
            MaxHeight="240"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="AnnotationContents"
            AutomationProperties.Name="{loc:Tr Annotation_Contents_Name}"
            PreviewKeyDown="OnContentsKeyDown"
            Text="{Binding ContentsDraft, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
          <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
              Margin="0,0,6,0"
              Command="{Binding CancelContentsCommand}"
              Content="{loc:Tr Common_Cancel}" />
            <ui:Button
              Appearance="Primary"
              AutomationProperties.AutomationId="AnnotationContentsDone"
              Command="{Binding CommitContentsCommand}"
              Content="{loc:Tr Annotation_Done}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <ScrollViewer
      x:Name="Scroller"
      AutomationProperties.AutomationId="DocumentScroller"
      AutomationProperties.Name="{Binding Title}"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      CanContentScroll="True"
      DataContext="{Binding Viewer}"
      Focusable="True"
      FocusVisualStyle="{x:Null}"
      HorizontalScrollBarVisibility="Auto"
      PreviewKeyDown="OnPreviewKeyDown"
      PreviewMouseDown="OnPreviewMouseDown"
      PreviewMouseWheel="OnPreviewMouseWheel"
      VerticalScrollBarVisibility="Visible"
      Visibility="{Binding DataContext.IsOrganizing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:DocumentViewPanel
        x:Name="Surface"
        AutomationProperties.AutomationId="DocumentSurface"
        Background="Transparent"
        DpiScale="{Binding DpiScale, Mode=TwoWay}"
        MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
        MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
        MouseMove="OnSurfaceMouseMove"
        Offset="{Binding ScrollOffset, Mode=TwoWay}"
        PageLayout="{Binding Layout}"
        PageTemplate="{StaticResource PageTemplate}"
        Pages="{Binding Pages}"
        ViewportSize="{Binding ViewportSize, Mode=TwoWay}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
