<ui:FluentWindow
  x:Class="PdfPro.App.Views.RecoveryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  Title="{loc:Tr Recovery_Title}"
  Width="560"
  MinHeight="0"
  AutomationProperties.AutomationId="RecoveryWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </ui:FluentWindow.InputBindings>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr Recovery_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon
          Margin="0,0,12,0"
          VerticalAlignment="Top"
          FontSize="28"
          Symbol="DocumentEdit24" />
        <TextBlock
          MaxWidth="440"
          VerticalAlignment="Center"
          Text="{loc:Tr Recovery_Message}"
          TextWrapping="Wrap" />
      </StackPanel>

      <Border
        Margin="0,16,0,0"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
          <ItemsControl AutomationProperties.AutomationId="RecoveryItems" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RecoveryItemViewModel}">
                <CheckBox
                  Margin="12,8"
                  AutomationProperties.Name="{Binding FileName}"
                  IsChecked="{Binding IsSelected}">
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding FileName}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding Folder}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="RecoveryUncheckedWarning"
        Foreground="{DynamicResource SystemFillColorCautionBrush}"
        Text="{Binding UncheckedWarning}"
        TextWrapping="Wrap"
        Visibility="{Binding HasUnchecked, Converter={StaticResource BoolToVisibility}}" />

      <Grid Margin="0,20,0,0" Visibility="{Binding IsConfirmingDiscard, Converter={StaticResource InverseBoolToVisibility}}">
        <ui:Button
          MinWidth="96"
          HorizontalAlignment="Left"
          AutomationProperties.AutomationId="RecoveryDiscardAll"
          Command="{Binding DiscardAllCommand}"
          Content="{loc:Tr Recovery_DiscardAll}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button
            MinWidth="96"
            Margin="0,0,8,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="RecoveryRestore"
            Command="{Binding RestoreCommand}"
            Content="{loc:Tr Recovery_Restore}"
            IsDefault="True" />
          <ui:Button
            MinWidth="96"
            AutomationProperties.AutomationId="RecoveryLater"
            Command="{Binding LaterCommand}"
            Content="{loc:Tr Recovery_Later}" />
        </StackPanel>
      </Grid>

      <StackPanel Margin="0,20,0,0" Visibility="{Binding IsConfirmingDiscard, Converter={StaticResource BoolToVisibility}}">
        <ui:InfoBar
          Title="{loc:Tr Recovery_DiscardAll}"
          IsClosable="False"
          IsOpen="True"
          Message="{Binding ConfirmDiscardText}"
          Severity="Warning" />
        <StackPanel
          Margin="0,12,0,0"
          HorizontalAlignment="Right"
          Orientation="Horizontal">
          <ui:Button
            MinWidth="96"
            Margin="0,0,8,0"
            Appearance="Danger"
            AutomationProperties.AutomationId="RecoveryConfirmDiscard"
            Command="{Binding ConfirmDiscardAllCommand}"
            Content="{loc:Tr Recovery_DiscardAll}" />
          <ui:Button
            MinWidth="96"
            AutomationProperties.AutomationId="RecoveryBack"
            Command="{Binding CancelDiscardCommand}"
            Content="{loc:Tr Recovery_Back}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
