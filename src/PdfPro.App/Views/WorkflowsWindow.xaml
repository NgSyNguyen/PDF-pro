<ui:FluentWindow
  x:Class="PdfPro.App.Views.WorkflowsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:automation="clr-namespace:PdfPro.App.ViewModels.Automation"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=automation:WorkflowsViewModel}"
  Title="{loc:Tr Workflow_Title}"
  Width="1100"
  Height="720"
  MinWidth="860"
  MinHeight="560"
  AutomationProperties.AutomationId="WorkflowsWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Tr Workflow_Title}" ShowMinimize="False" />

    <Grid Grid.Row="1" Margin="24,4,24,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The library. -->
      <DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <ui:Button Margin="0,0,6,6" AutomationProperties.AutomationId="WorkflowNew" Command="{Binding NewCommand}" Content="{loc:Tr Workflow_New}" />
          <ui:Button Margin="0,0,6,6" Command="{Binding DuplicateCommand}" Content="{loc:Tr Workflow_Duplicate}" />
          <ui:Button Margin="0,0,6,6" Command="{Binding DeleteCommand}" Content="{loc:Tr Workflow_Delete}" />
          <ui:Button Margin="0,0,6,6" Command="{Binding ImportCommand}" Content="{loc:Tr Workflow_Import}" />
          <ui:Button Margin="0,0,6,6" Command="{Binding ExportCommand}" Content="{loc:Tr Workflow_Export}" />
        </WrapPanel>
        <ListBox
          AutomationProperties.AutomationId="WorkflowList"
          ItemsSource="{Binding Items}"
          SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type automation:WorkflowListItem}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,8,0" Symbol="Flow20" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                  Margin="6,0,0,0"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{loc:Tr Workflow_BuiltIn}"
                  Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- The designer. -->
      <ScrollViewer Grid.Column="2" DataContext="{Binding Editor}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Margin="0,0,0,4" Text="{loc:Tr Workflow_Name}" />
          <ui:TextBox AutomationProperties.AutomationId="WorkflowName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,8,0,4" Text="{loc:Tr Workflow_Description}" />
          <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{loc:Tr Workflow_Steps}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox
              MinHeight="120"
              MaxHeight="220"
              AutomationProperties.AutomationId="WorkflowSteps"
              ItemsSource="{Binding Steps}"
              SelectedItem="{Binding SelectedStep}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type automation:WorkflowStepViewModel}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Margin="0,0,4,0" IsChecked="{Binding Enabled}" ToolTip="{loc:Tr Workflow_StepEnabled}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Number, StringFormat={}{0}.}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                    <ui:SymbolIcon
                      Margin="8,0,0,0"
                      Symbol="LockClosed16"
                      ToolTip="{loc:Tr Workflow_AsksWhenRun}"
                      Visibility="{Binding AsksWhenRun, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <ui:Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Command="{Binding MoveStepUpCommand}" Content="{loc:Tr Workflow_StepUp}" />
              <ui:Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Command="{Binding MoveStepDownCommand}" Content="{loc:Tr Workflow_StepDown}" />
              <ui:Button HorizontalAlignment="Stretch" Command="{Binding RemoveStepCommand}" Content="{loc:Tr Workflow_StepRemove}" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
              AutomationProperties.AutomationId="WorkflowOperation"
              AutomationProperties.Name="{loc:Tr Workflow_AddStep}"
              DisplayMemberPath="Name"
              IsEditable="False"
              ItemsSource="{Binding Operations}"
              SelectedItem="{Binding OperationToAdd}" />
            <ui:Button
              Grid.Column="1"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="WorkflowAddStep"
              Command="{Binding AddStepCommand}"
              Content="{loc:Tr Workflow_AddStep}"
              Icon="{ui:SymbolIcon Add20}" />
          </Grid>

          <!-- The form of the selected step, made from its parameter record. -->
          <Border
            Margin="0,12,0,0"
            Padding="12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            DataContext="{Binding SelectedStep}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Tr Workflow_AsksWhenRun}"
                TextWrapping="Wrap"
                Visibility="{Binding AsksWhenRun, Converter={StaticResource BoolToVisibility}}" />
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type automation:ParameterFieldViewModel}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="0,6,8,0" Text="{Binding Label}" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1">
                        <CheckBox IsChecked="{Binding IsChecked}" Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox
                          MinHeight="60"
                          AcceptsReturn="True"
                          FontFamily="Consolas"
                          Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                          TextWrapping="Wrap"
                          Visibility="{Binding IsJson, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Range}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{loc:Tr Workflow_Output}" />
          <ComboBox DisplayMemberPath="Text" ItemsSource="{Binding OutputModes}" SelectedItem="{Binding OutputMode}" />
          <StackPanel Margin="0,8,0,0" Visibility="{Binding IsFolderOutput, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Margin="0,0,0,4" Text="{loc:Tr Workflow_OutputFolder}" TextWrapping="Wrap" />
            <ui:TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSuffixOutput, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Margin="0,0,0,4" Text="{loc:Tr Workflow_OutputSuffix}" />
            <ui:TextBox Text="{Binding OutputSuffix, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <CheckBox Margin="0,8,0,0" Content="{loc:Tr Workflow_ReplaceExisting}" IsChecked="{Binding ReplaceExisting}" />

          <ItemsControl Margin="0,12,0,0" AutomationProperties.AutomationId="WorkflowProblems" ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Margin="0,0,0,4" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="{Binding Message}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" AutomationProperties.AutomationId="WorkflowSave" Command="{Binding SaveCommand}" Content="{loc:Tr Workflow_Save}" />
        <ui:Button Margin="0,0,8,0" AutomationProperties.AutomationId="WorkflowRunOnDocument" Command="{Binding RunOnDocumentCommand}" Content="{loc:Tr Workflow_RunOnDocument}" />
        <ui:Button Margin="0,0,8,0" Appearance="Primary" AutomationProperties.AutomationId="WorkflowRunBatch" Command="{Binding RunBatchCommand}" Content="{loc:Tr Workflow_RunBatch}" />
        <ui:Button Command="{Binding CloseCommand}" Content="{loc:Tr Common_Close}" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>
