<ui:FluentWindow
  x:Class="PdfPro.App.Views.SplitWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:controls="clr-namespace:PdfPro.App.Controls"
  xmlns:splitting="clr-namespace:PdfPro.App.ViewModels.Splitting"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=splitting:SplitViewModel}"
  Title="{loc:Tr Split_Title}"
  Width="1040"
  Height="720"
  MinWidth="820"
  MinHeight="520"
  AutomationProperties.AutomationId="SplitWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </ui:FluentWindow.Resources>

  <DockPanel>
    <ui:TitleBar
      Title="{loc:Tr Split_Title}"
      DockPanel.Dock="Top"
      ShowMinimize="False" />

    <!-- Naming, folder and the buttons -->
    <Border
      Padding="24,12,24,20"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0"
      DockPanel.Dock="Bottom">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Margin="0,0,12,0"
          VerticalAlignment="Center"
          Text="{loc:Tr Split_NamePattern_Label}" />
        <TextBox
          Grid.Column="1"
          AutomationProperties.AutomationId="SplitNamePattern"
          AutomationProperties.Name="{loc:Tr Split_NamePattern_Label}"
          Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          Style="{StaticResource Hint}"
          Text="{loc:Tr Split_NamePattern_Help}" />

        <TextBlock
          Grid.Row="2"
          Margin="0,10,12,0"
          VerticalAlignment="Center"
          Text="{loc:Tr Split_Folder_Label}" />
        <TextBox
          Grid.Row="2"
          Grid.Column="1"
          Margin="0,10,0,0"
          AutomationProperties.AutomationId="SplitFolder"
          AutomationProperties.Name="{loc:Tr Split_Folder_Label}"
          Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button
          Grid.Row="2"
          Grid.Column="2"
          Margin="8,10,0,0"
          AutomationProperties.AutomationId="SplitPickFolder"
          Command="{Binding PickFolderCommand}"
          Content="{loc:Tr Split_Folder_Pick}" />

        <DockPanel
          Grid.Row="3"
          Grid.ColumnSpan="3"
          Margin="0,14,0,0"
          LastChildFill="False">
          <CheckBox
            AutomationProperties.AutomationId="SplitOverwrite"
            Content="{loc:Tr Split_Overwrite}"
            DockPanel.Dock="Left"
            IsChecked="{Binding Overwrite}" />
          <CheckBox
            Margin="16,0,0,0"
            AutomationProperties.AutomationId="SplitOpenFolder"
            Content="{loc:Tr Split_OpenFolder}"
            DockPanel.Dock="Left"
            IsChecked="{Binding OpenFolderWhenDone}" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="SplitCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Common_Cancel}"
            DockPanel.Dock="Right" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="SplitRun"
            Command="{Binding RunCommand}"
            Content="{loc:Tr Split_Run}"
            DockPanel.Dock="Right"
            IsDefault="True" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="SplitConvertToMarks"
            Command="{Binding ConvertToMarksCommand}"
            Content="{loc:Tr Split_ConvertToMarks}"
            DockPanel.Dock="Right"
            ToolTip="{loc:Tr Split_ConvertToMarks_ToolTip}" />
        </DockPanel>
      </Grid>
    </Border>

    <Grid Margin="24,4,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- How to split, and the settings of the chosen mode -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="{loc:Tr Split_Mode_Header}" />
          <StackPanel
            Margin="0,2,0,0"
            AutomationProperties.AutomationId="SplitModes"
            AutomationProperties.Name="{loc:Tr Split_Mode_Header}">
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_FirstPages"
              Content="{loc:Tr Split_Mode_FirstPages}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=FirstPages}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_Ranges"
              Content="{loc:Tr Split_Mode_Ranges}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Ranges}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_EveryN"
              Content="{loc:Tr Split_Mode_EveryN}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=EveryN}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_Bookmarks"
              Content="{loc:Tr Split_Mode_Bookmarks}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Bookmarks}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_Size"
              Content="{loc:Tr Split_Mode_Size}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Size}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_BlankSeparators"
              Content="{loc:Tr Split_Mode_Blank}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=BlankSeparators}" />
            <RadioButton
              Margin="0,4,0,0"
              AutomationProperties.AutomationId="SplitMode_Text"
              Content="{loc:Tr Split_Mode_Text}"
              GroupName="SplitMode"
              IsChecked="{Binding Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Text}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsFirstPages, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_FirstPages_Label}" />
            <TextBox
              AutomationProperties.AutomationId="SplitFirstPages"
              AutomationProperties.Name="{loc:Tr Split_FirstPages_Label}"
              Text="{Binding FirstPagesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Split_FirstPages_Hint}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsRanges, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_Ranges_Label}" />
            <TextBox
              AutomationProperties.AutomationId="SplitRanges"
              AutomationProperties.Name="{loc:Tr Split_Ranges_Label}"
              Text="{Binding RangesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Split_Ranges_Hint}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsEveryN, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_EveryN_Label}" />
            <TextBox
              AutomationProperties.AutomationId="SplitPagesPerFile"
              AutomationProperties.Name="{loc:Tr Split_EveryN_Label}"
              Text="{Binding PagesPerFileText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsBookmarks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_Bookmarks_Label}" />
            <ComboBox
              AutomationProperties.AutomationId="SplitBookmarkLevel"
              AutomationProperties.Name="{loc:Tr Split_Bookmarks_Label}"
              ItemsSource="{Binding BookmarkLevels}"
              SelectedItem="{Binding BookmarkLevel}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsSize, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_Size_Label}" />
            <TextBox
              AutomationProperties.AutomationId="SplitMaxMegabytes"
              AutomationProperties.Name="{loc:Tr Split_Size_Label}"
              Text="{Binding MaxMegabytesText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>

          <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_Text_Label}" />
            <TextBox
              AutomationProperties.AutomationId="SplitTextPattern"
              AutomationProperties.Name="{loc:Tr Split_Text_Label}"
              FontFamily="Consolas"
              Text="{Binding TextPattern, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr Split_Text_Hint}" />
            <CheckBox
              Margin="0,8,0,0"
              AutomationProperties.AutomationId="SplitMatchCase"
              Content="{loc:Tr Split_Text_MatchCase}"
              IsChecked="{Binding MatchCase}" />
          </StackPanel>

          <CheckBox
            Margin="0,16,0,0"
            AutomationProperties.AutomationId="SplitSkipBlank"
            AutomationProperties.Name="{loc:Tr Split_SkipBlank}"
            IsChecked="{Binding SkipBlankPages}"
            Visibility="{Binding CanSkipBlankPages, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Tr Split_SkipBlank}" TextWrapping="Wrap" />
          </CheckBox>

          <StackPanel Visibility="{Binding ShowsBlankThreshold, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Split_Blank_Label}" />
            <DockPanel>
              <TextBlock
                Width="44"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Text="{Binding BlankThreshold, StringFormat={}{0:0.00}}"
                TextAlignment="Right" />
              <Slider
                AutomationProperties.AutomationId="SplitBlankThreshold"
                AutomationProperties.Name="{loc:Tr Split_Blank_Label}"
                IsSnapToTickEnabled="True"
                LargeChange="0.1"
                Maximum="2"
                Minimum="0"
                SmallChange="0.05"
                TickFrequency="0.05"
                Value="{Binding BlankThreshold}" />
            </DockPanel>
            <TextBlock
              AutomationProperties.AutomationId="SplitBlankFound"
              Style="{StaticResource Hint}"
              Text="{Binding BlankPagesText}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Preview of the files -->
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock
            FontWeight="SemiBold"
            DockPanel.Dock="Left"
            Text="{loc:Tr Split_Preview_Header}" />
          <TextBlock
            AutomationProperties.AutomationId="SplitSummary"
            DockPanel.Dock="Right"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}" />
        </DockPanel>

        <StackPanel
          Margin="0,8,0,0"
          DockPanel.Dock="Top"
          Orientation="Horizontal"
          Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
          <ui:ProgressRing
            Width="16"
            Height="16"
            IsIndeterminate="True" />
          <TextBlock
            Margin="8,0,12,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="SplitAnalysis"
            Text="{Binding AnalysisText}" />
          <ui:Button
            Padding="10,2"
            AutomationProperties.AutomationId="SplitStopAnalysis"
            Command="{Binding StopAnalysisCommand}"
            Content="{loc:Tr Split_Stop}" />
        </StackPanel>

        <TextBlock
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="SplitError"
          DockPanel.Dock="Top"
          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
          Text="{Binding ErrorText}"
          TextWrapping="Wrap"
          Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
        <TextBlock
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="SplitWarning"
          DockPanel.Dock="Top"
          Foreground="{DynamicResource SystemFillColorCautionBrush}"
          Text="{Binding WarningText}"
          TextWrapping="Wrap"
          Visibility="{Binding WarningText, Converter={StaticResource NullToCollapsed}}" />

        <!-- Column headers -->
        <Grid
          Margin="8,10,24,4"
          DockPanel.Dock="Top"
          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="2" Text="{loc:Tr Split_Column_Pages}" />
          <TextBlock Grid.Column="3" Text="{loc:Tr Split_Column_Count}" />
          <TextBlock Grid.Column="4" Text="{loc:Tr Split_Column_Name}" />
        </Grid>

        <ListBox
          AutomationProperties.AutomationId="SplitRows"
          AutomationProperties.Name="{loc:Tr Split_Preview_Header}"
          HorizontalContentAlignment="Stretch"
          ItemsSource="{Binding Rows}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type splitting:SplitRowViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                  Width="44"
                  Height="60"
                  HorizontalAlignment="Left"
                  Background="White"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1">
                  <Image
                    controls:Realization.IsEnabled="True"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Thumbnail}"
                    Stretch="Uniform" />
                </Border>
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="{Binding Index, StringFormat={loc:Tr Split_Row_File}}" />
                <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Text="{Binding PagesText}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding PagesText}" />
                <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Text="{Binding PageCount}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                  <TextBox
                    AutomationProperties.AutomationId="SplitRowName"
                    AutomationProperties.Name="{loc:Tr Split_Column_Name}"
                    Text="{Binding FileName, UpdateSourceTrigger=LostFocus}" />
                  <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding FinalNameText}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding FinalNameText, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
