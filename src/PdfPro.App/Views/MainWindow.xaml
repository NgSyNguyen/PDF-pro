<ui:FluentWindow
  x:Class="PdfPro.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
  Title="{loc:Tr App_Title}"
  Width="1280"
  Height="800"
  MinWidth="960"
  MinHeight="600"
  WindowStartupLocation="CenterScreen"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round">

  <ui:FluentWindow.Resources>
    <!--
      Disabled ribbon buttons stay flat so they do not look more prominent than enabled ones.
      The WPF-UI template reads these brushes through DynamicResource, so overriding them here is enough.
    -->
    <Style
      x:Key="RibbonButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Style.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
      </Style.Resources>
    </Style>

    <!-- Large ribbon button: icon above label. -->
    <DataTemplate x:Key="RibbonCommandTemplate" DataType="{x:Type vm:RibbonCommandViewModel}">
      <ui:Button
        MinWidth="64"
        MinHeight="62"
        Margin="1,0"
        Padding="6,4"
        VerticalAlignment="Stretch"
        Appearance="Transparent"
        AutomationProperties.AutomationId="{Binding Id}"
        AutomationProperties.Name="{Binding Label}"
        BorderThickness="0"
        Command="{Binding Command}"
        Style="{StaticResource RibbonButtonStyle}"
        ToolTip="{Binding ToolTip}"
        ToolTipService.ShowOnDisabled="True">
        <StackPanel>
          <ui:SymbolIcon HorizontalAlignment="Center" FontSize="22" Symbol="{Binding Icon}" />
          <TextBlock
            MaxWidth="84"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            FontSize="12"
            Text="{Binding Label}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </ui:Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HomeTabViewModel}">
      <views:HomeView />
    </DataTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Tr App_Title}">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="DocumentPdf24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Ribbon -->
    <TabControl
      Grid.Row="1"
      Margin="8,0,8,4"
      AutomationProperties.AutomationId="Ribbon"
      ItemsSource="{Binding RibbonTabs}"
      SelectedIndex="0">
      <TabControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
          <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=RibbonTab_{0}}" />
        </Style>
      </TabControl.ItemContainerStyle>
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:RibbonTabViewModel}">
          <TextBlock Text="{Binding Header}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type vm:RibbonTabViewModel}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl Focusable="False" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RibbonGroupViewModel}">
                  <Border
                    Margin="0,4,4,2"
                    Padding="2,0,6,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ItemsControl
                        Focusable="False"
                        ItemTemplate="{StaticResource RibbonCommandTemplate}"
                        ItemsSource="{Binding Commands}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Header}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Workspace: sidebar | document tabs | properties -->
    <Grid Grid.Row="2" Margin="8,0,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="240"
          MinWidth="160"
          MaxWidth="480" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition
          Width="260"
          MinWidth="180"
          MaxWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Left sidebar -->
      <Border
        Grid.Column="0"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        DataContext="{Binding Sidebar}">
        <DockPanel>
          <!-- Segmented switch; icon above label so both fit the narrowest sidebar. -->
          <UniformGrid
            Margin="8"
            Columns="2"
            DockPanel.Dock="Top">
            <RadioButton
              Margin="0,0,2,0"
              Padding="4,6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              AutomationProperties.AutomationId="SidebarThumbnails"
              AutomationProperties.Name="{loc:Tr Sidebar_Thumbnails}"
              GroupName="SidebarPanel"
              IsChecked="{Binding IsThumbnailsSelected}"
              Style="{StaticResource {x:Type ToggleButton}}">
              <StackPanel>
                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="GridDots24" />
                <TextBlock
                  Margin="0,2,0,0"
                  HorizontalAlignment="Center"
                  FontSize="12"
                  Text="{loc:Tr Sidebar_Thumbnails}" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              Margin="2,0,0,0"
              Padding="4,6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              AutomationProperties.AutomationId="SidebarBookmarks"
              AutomationProperties.Name="{loc:Tr Sidebar_Bookmarks}"
              GroupName="SidebarPanel"
              IsChecked="{Binding IsBookmarksSelected}"
              Style="{StaticResource {x:Type ToggleButton}}">
              <StackPanel>
                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Bookmark24" />
                <TextBlock
                  Margin="0,2,0,0"
                  HorizontalAlignment="Center"
                  FontSize="12"
                  Text="{loc:Tr Sidebar_Bookmarks}" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
          <Grid Margin="16">
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{loc:Tr Sidebar_ThumbnailsEmpty}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              Visibility="{Binding IsThumbnailsSelected, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{loc:Tr Sidebar_BookmarksEmpty}"
              TextAlignment="Center"
              TextWrapping="Wrap"
              Visibility="{Binding IsBookmarksSelected, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter
        Grid.Column="1"
        Width="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Focusable="False"
        ResizeBehavior="PreviousAndNext" />

      <!-- Document tabs (the home tab until documents are opened) -->
      <TabControl
        Grid.Column="2"
        AutomationProperties.AutomationId="DocumentTabs"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:WorkspaceTabViewModel}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" Symbol="Home24" />
              <TextBlock Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <GridSplitter
        Grid.Column="3"
        Width="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Focusable="False"
        ResizeBehavior="PreviousAndNext" />

      <!-- Properties panel -->
      <Border
        Grid.Column="4"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <DockPanel>
          <TextBlock
            Margin="12,12,12,4"
            DockPanel.Dock="Top"
            FontWeight="SemiBold"
            Text="{loc:Tr Properties_Title}" />
          <TextBlock
            Margin="16"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Properties_Empty}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border
      Grid.Row="3"
      Padding="16,4"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0"
      DataContext="{Binding StatusBar}">
      <DockPanel LastChildFill="False">
        <TextBlock
          AutomationProperties.AutomationId="StatusPage"
          DockPanel.Dock="Left"
          Text="{Binding PageText}" />
        <TextBlock
          Margin="24,0,0,0"
          AutomationProperties.AutomationId="StatusZoom"
          DockPanel.Dock="Left"
          Text="{Binding ZoomText}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ProgressBar
            Width="160"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Maximum="1"
            Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}"
            Value="{Binding TaskProgress}" />
          <TextBlock AutomationProperties.AutomationId="StatusTask" Text="{Binding TaskText}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
