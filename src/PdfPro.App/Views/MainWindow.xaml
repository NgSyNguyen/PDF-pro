<ui:FluentWindow
  x:Class="PdfPro.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
  Title="{loc:Tr App_Title}"
  Width="1280"
  Height="800"
  MinWidth="960"
  MinHeight="600"
  WindowStartupLocation="CenterScreen"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  AllowDrop="True"
  DragOver="OnDragOver"
  Drop="OnDrop">

  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="O" Command="{Binding OpenCommand}" Modifiers="Control" />
    <KeyBinding Key="S" Command="{Binding SaveCommand}" Modifiers="Control" />
    <KeyBinding Key="S" Command="{Binding SaveAsCommand}" Modifiers="Control+Shift" />
    <KeyBinding Key="W" Command="{Binding CloseActiveDocumentCommand}" Modifiers="Control" />
    <KeyBinding Key="F4" Command="{Binding CloseActiveDocumentCommand}" Modifiers="Control" />
    <KeyBinding Key="D" Command="{Binding ShowPropertiesCommand}" Modifiers="Control" />
    <KeyBinding Key="P" Command="{Binding PrintCommand}" Modifiers="Control" />
    <KeyBinding Key="OemPlus" Command="{Binding ActiveDocument.Viewer.ZoomInCommand}" Modifiers="Control" />
    <KeyBinding Key="Add" Command="{Binding ActiveDocument.Viewer.ZoomInCommand}" Modifiers="Control" />
    <KeyBinding Key="OemMinus" Command="{Binding ActiveDocument.Viewer.ZoomOutCommand}" Modifiers="Control" />
    <KeyBinding Key="Subtract" Command="{Binding ActiveDocument.Viewer.ZoomOutCommand}" Modifiers="Control" />
    <KeyBinding Key="D0" Command="{Binding ActiveDocument.Viewer.FitPageCommand}" Modifiers="Control" />
    <KeyBinding Key="NumPad0" Command="{Binding ActiveDocument.Viewer.FitPageCommand}" Modifiers="Control" />
    <KeyBinding Key="D1" Command="{Binding ActiveDocument.Viewer.ActualSizeCommand}" Modifiers="Control" />
    <KeyBinding Key="NumPad1" Command="{Binding ActiveDocument.Viewer.ActualSizeCommand}" Modifiers="Control" />
    <KeyBinding Key="D2" Command="{Binding ActiveDocument.Viewer.FitWidthCommand}" Modifiers="Control" />
    <KeyBinding Key="NumPad2" Command="{Binding ActiveDocument.Viewer.FitWidthCommand}" Modifiers="Control" />
    <KeyBinding Key="G" Command="{x:Static views:MainWindow.GoToPageCommand}" Modifiers="Control" />
    <KeyBinding Key="Z" Command="{Binding UndoCommand}" Modifiers="Control" />
    <KeyBinding Key="Y" Command="{Binding RedoCommand}" Modifiers="Control" />
    <KeyBinding Key="Z" Command="{Binding RedoCommand}" Modifiers="Control+Shift" />
    <KeyBinding Key="R" Command="{Binding RotateRightCommand}" Modifiers="Control" />
    <KeyBinding Key="R" Command="{Binding RotateLeftCommand}" Modifiers="Control+Shift" />
    <KeyBinding Key="M" Command="{Binding MarkSplitCommand}" Modifiers="Control" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.CommandBindings>
    <CommandBinding Command="{x:Static views:MainWindow.GoToPageCommand}" Executed="OnGoToPage" />
  </ui:FluentWindow.CommandBindings>

  <ui:FluentWindow.Resources>
    <!--
      Disabled ribbon buttons stay flat so they do not look more prominent than enabled ones.
      The WPF-UI template reads these brushes through DynamicResource, so overriding them here is enough.
    -->
    <Style
      x:Key="RibbonButtonStyle"
      BasedOn="{StaticResource {x:Type ui:Button}}"
      TargetType="ui:Button">
      <Style.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
      </Style.Resources>
    </Style>

    <!-- Large ribbon button: icon above label. -->
    <DataTemplate x:Key="RibbonCommandTemplate" DataType="{x:Type vm:RibbonCommandViewModel}">
      <ui:Button
        MinWidth="64"
        MinHeight="62"
        Margin="1,0"
        Padding="6,4"
        VerticalAlignment="Stretch"
        Appearance="Transparent"
        AutomationProperties.AutomationId="{Binding Id}"
        AutomationProperties.Name="{Binding Label}"
        BorderThickness="0"
        Command="{Binding Command}"
        Style="{StaticResource RibbonButtonStyle}"
        ToolTip="{Binding ToolTip}"
        ToolTipService.ShowOnDisabled="True">
        <StackPanel>
          <ui:SymbolIcon HorizontalAlignment="Center" FontSize="22" Symbol="{Binding Icon}" />
          <TextBlock
            MaxWidth="84"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            FontSize="12"
            Text="{Binding Label}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </ui:Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HomeTabViewModel}">
      <views:HomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DocumentTabViewModel}">
      <views:DocumentView />
    </DataTemplate>

    <Style x:Key="StatusIconButton" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusToggle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="RadioButton">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Tr App_Title}">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="DocumentPdf24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Ribbon -->
    <TabControl
      Grid.Row="1"
      Margin="8,0,8,4"
      AutomationProperties.AutomationId="Ribbon"
      ItemsSource="{Binding RibbonTabs}"
      SelectedIndex="0">
      <TabControl.ItemContainerStyle>
        <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
          <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=RibbonTab_{0}}" />
        </Style>
      </TabControl.ItemContainerStyle>
      <TabControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:RibbonTabViewModel}">
          <TextBlock Text="{Binding Header}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="{x:Type vm:RibbonTabViewModel}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl Focusable="False" ItemsSource="{Binding Groups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RibbonGroupViewModel}">
                  <Border
                    Margin="0,4,4,2"
                    Padding="2,0,6,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ItemsControl
                        Focusable="False"
                        ItemTemplate="{StaticResource RibbonCommandTemplate}"
                        ItemsSource="{Binding Commands}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Header}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Workspace: sidebar | document tabs | properties -->
    <Grid Grid.Row="2" Margin="8,0,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          x:Name="SidebarColumn"
          Width="240"
          MinWidth="220"
          MaxWidth="480" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition
          Width="260"
          MinWidth="180"
          MaxWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Left sidebar -->
      <views:SidebarView x:Name="Sidebar" Grid.Column="0" />

      <GridSplitter
        x:Name="SidebarSplitter"
        Grid.Column="1"
        Width="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Focusable="False"
        ResizeBehavior="PreviousAndNext" />

      <!-- Document tabs (the home tab until documents are opened) -->
      <TabControl
        Grid.Column="2"
        AutomationProperties.AutomationId="DocumentTabs"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
          </Style>
        </TabControl.ItemContainerStyle>
        <TabControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:WorkspaceTabViewModel}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
              <ui:SymbolIcon Margin="0,0,6,0" Symbol="{Binding Icon}" />
              <TextBlock
                MaxWidth="220"
                VerticalAlignment="Center"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis" />
              <ui:Button
                Margin="6,0,-4,0"
                Padding="3"
                VerticalAlignment="Center"
                Appearance="Transparent"
                AutomationProperties.AutomationId="CloseTab"
                AutomationProperties.Name="{loc:Tr Tab_Close_ToolTip}"
                BorderThickness="0"
                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                CommandParameter="{Binding}"
                Icon="{ui:SymbolIcon Dismiss12}"
                ToolTip="{loc:Tr Tab_Close_ToolTip}"
                Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <GridSplitter
        Grid.Column="3"
        Width="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Focusable="False"
        ResizeBehavior="PreviousAndNext" />

      <!-- Properties panel -->
      <Border
        Grid.Column="4"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <DockPanel>
          <TextBlock
            Margin="12,12,12,4"
            DockPanel.Dock="Top"
            FontWeight="SemiBold"
            Text="{loc:Tr Properties_Title}" />
          <TextBlock
            Margin="16"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Properties_Empty}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Status bar: page navigation (left), zoom and layout (right) for the active document; task progress -->
    <Border
      Grid.Row="3"
      Padding="12,2"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False">
        <StackPanel
          DataContext="{Binding ActiveDocument.Viewer}"
          DockPanel.Dock="Left"
          Orientation="Horizontal"
          Visibility="{Binding DataContext.ShowsViewerStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
          <TextBlock VerticalAlignment="Center" Text="{loc:Tr Status_PageLabel}" />
          <TextBox
            x:Name="PageNumberBox"
            Width="64"
            Margin="6,0"
            Padding="6,2"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="PageNumberBox"
            AutomationProperties.Name="{loc:Tr Status_PageLabel}"
            HorizontalContentAlignment="Center"
            Text="{Binding CurrentPageNumber, Mode=OneWay}"
            ToolTip="{loc:Tr Status_PageInput_ToolTip}">
            <TextBox.InputBindings>
              <KeyBinding
                Key="Enter"
                Command="{Binding GoToPageNumberCommand}"
                CommandParameter="{Binding Text, ElementName=PageNumberBox}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="PageCountText"
            Text="{Binding PageCount, StringFormat={loc:Tr Status_PageCount}}" />
          <!-- "Tệp 3/13" while the document has first-page marks for a split. -->
          <TextBlock
            Margin="16,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="CurrentSplitFile"
            DataContext="{Binding DataContext.ActiveDocument, RelativeSource={RelativeSource AncestorType=Window}}"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding CurrentSplitFile}"
            Visibility="{Binding CurrentSplitFile, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <StackPanel
          DataContext="{Binding ActiveDocument.Viewer}"
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Visibility="{Binding DataContext.ShowsViewerStatus, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
          <RadioButton
            AutomationProperties.AutomationId="LayoutSingle"
            AutomationProperties.Name="{loc:Tr Layout_Single}"
            GroupName="PageLayout"
            IsChecked="{Binding IsSingleLayout}"
            Style="{StaticResource StatusToggle}"
            ToolTip="{loc:Tr Layout_Single}">
            <ui:SymbolIcon Symbol="DocumentOnePage24" />
          </RadioButton>
          <RadioButton
            AutomationProperties.AutomationId="LayoutFacing"
            AutomationProperties.Name="{loc:Tr Layout_Facing}"
            GroupName="PageLayout"
            IsChecked="{Binding IsFacingLayout}"
            Style="{StaticResource StatusToggle}"
            ToolTip="{loc:Tr Layout_Facing}">
            <ui:SymbolIcon Symbol="BookOpen24" />
          </RadioButton>
          <RadioButton
            Margin="1,0,12,0"
            AutomationProperties.AutomationId="LayoutFacingWithCover"
            AutomationProperties.Name="{loc:Tr Layout_FacingWithCover}"
            GroupName="PageLayout"
            IsChecked="{Binding IsFacingWithCoverLayout}"
            Style="{StaticResource StatusToggle}"
            ToolTip="{loc:Tr Layout_FacingWithCover}">
            <ui:SymbolIcon Symbol="Book24" />
          </RadioButton>
          <ui:Button
            AutomationProperties.AutomationId="ZoomOut"
            AutomationProperties.Name="{loc:Tr Zoom_Out_ToolTip}"
            Command="{Binding ZoomOutCommand}"
            Icon="{ui:SymbolIcon ZoomOut24}"
            Style="{StaticResource StatusIconButton}"
            ToolTip="{loc:Tr Zoom_Out_ToolTip}" />
          <ui:DropDownButton
            MinWidth="84"
            Padding="8,2"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ZoomMenu"
            AutomationProperties.Name="{loc:Tr Zoom_Menu_ToolTip}"
            Content="{Binding ZoomText}"
            ToolTip="{loc:Tr Zoom_Menu_ToolTip}">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding ZoomMenu}">
                <ContextMenu.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                    <Setter Property="Header" Value="{Binding Label}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                    <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                  </Style>
                </ContextMenu.ItemContainerStyle>
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button
            AutomationProperties.AutomationId="ZoomIn"
            AutomationProperties.Name="{loc:Tr Zoom_In_ToolTip}"
            Command="{Binding ZoomInCommand}"
            Icon="{ui:SymbolIcon ZoomIn24}"
            Style="{StaticResource StatusIconButton}"
            ToolTip="{loc:Tr Zoom_In_ToolTip}" />
        </StackPanel>

        <StackPanel
          Margin="0,0,24,0"
          DataContext="{Binding StatusBar}"
          DockPanel.Dock="Right"
          Orientation="Horizontal">
          <ProgressBar
            Width="160"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="StatusTaskProgress"
            Maximum="1"
            Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}"
            Value="{Binding TaskProgress}" />
          <TextBlock
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="StatusTask"
            Text="{Binding TaskText}" />
          <ui:Button
            Margin="4,0,0,0"
            AutomationProperties.AutomationId="CancelTask"
            AutomationProperties.Name="{loc:Tr Status_CancelTask}"
            Command="{Binding CancelTaskCommand}"
            Icon="{ui:SymbolIcon Dismiss16}"
            Style="{StaticResource StatusIconButton}"
            ToolTip="{loc:Tr Status_CancelTask}"
            Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
