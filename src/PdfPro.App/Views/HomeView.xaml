<UserControl
  x:Class="PdfPro.App.Views.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:HomeTabViewModel}"
  d:DesignHeight="600"
  d:DesignWidth="800">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel
      MaxWidth="640"
      Margin="32"
      HorizontalAlignment="Center">
      <ui:SymbolIcon
        HorizontalAlignment="Center"
        FontSize="56"
        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
        Symbol="DocumentPdf24" />
      <ui:TextBlock
        Margin="0,12,0,4"
        HorizontalAlignment="Center"
        FontTypography="Title"
        Text="{loc:Tr Welcome_Title}"
        TextWrapping="Wrap" />
      <TextBlock
        HorizontalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Welcome_Subtitle}"
        TextAlignment="Center"
        TextWrapping="Wrap" />

      <ui:Button
        Margin="0,24,0,0"
        Padding="20,8"
        HorizontalAlignment="Center"
        Appearance="Primary"
        AutomationProperties.AutomationId="WelcomeOpenFile"
        Command="{Binding OpenFileCommand}"
        Content="{loc:Tr Welcome_OpenFile}"
        Icon="{ui:SymbolIcon FolderOpen24}"
        ToolTip="{loc:Tr Welcome_OpenFile_ToolTip}" />
      <ui:Button
        Margin="0,8,0,0"
        Padding="20,8"
        HorizontalAlignment="Center"
        AutomationProperties.AutomationId="WelcomeMerge"
        Command="{Binding MergeCommand}"
        Content="{loc:Tr Welcome_Merge}"
        Icon="{ui:SymbolIcon Merge24}"
        ToolTip="{loc:Tr Welcome_Merge_ToolTip}" />

      <!--
        Quick-start guide (SPEC Phase 13): four steps, until put away; Tệp › Hướng dẫn nhanh brings it back.
        A UserControl carries the name and id: a Border has no automation peer, so screen readers would not see the group.
      -->
      <UserControl
        Margin="0,24,0,0"
        AutomationProperties.AutomationId="QuickStartGuide"
        AutomationProperties.Name="{loc:Tr Guide_Title}"
        Focusable="False"
        IsTabStop="False"
        Visibility="{Binding ShowsGuide, Converter={StaticResource BoolToVisibility}}">
        <Border
          Padding="16"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <StackPanel>
            <Grid>
              <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Guide_Title}" />
              <ui:Button
                HorizontalAlignment="Right"
                Appearance="Transparent"
                AutomationProperties.AutomationId="HideGuide"
                Command="{Binding HideGuideCommand}"
                Content="{loc:Tr Guide_Hide}"
                ToolTip="{loc:Tr Guide_Hide_ToolTip}" />
            </Grid>
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding GuideSteps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GuideStep}">
                  <Grid Margin="0,6,12,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                      Margin="0,2,10,0"
                      VerticalAlignment="Top"
                      FontSize="24"
                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                      Symbol="{Binding Icon}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock
                        Margin="0,2,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Text}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </UserControl>

      <!-- Drop zone: the whole window accepts dropped files; this area just invites the gesture. -->
      <Grid Height="160" Margin="0,24,0,0">
        <Rectangle
          Fill="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          RadiusX="8"
          RadiusY="8"
          Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
          StrokeDashArray="4 3"
          StrokeThickness="2" />
        <StackPanel
          Margin="16"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            FontSize="32"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Symbol="ArrowUpload24" />
          <TextBlock
            Margin="0,8,0,4"
            HorizontalAlignment="Center"
            FontSize="16"
            Text="{loc:Tr Welcome_DropZone}" />
          <TextBlock
            HorizontalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Welcome_DropZoneHint}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <TextBlock
        Margin="0,32,0,8"
        FontWeight="SemiBold"
        Text="{loc:Tr Welcome_RecentFiles}" />
      <ItemsControl AutomationProperties.AutomationId="RecentFiles" ItemsSource="{Binding RecentFiles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:RecentFileViewModel}">
            <ui:Button
              Margin="0,0,0,4"
              Padding="10,6"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Appearance="Transparent"
              AutomationProperties.Name="{Binding FileName}"
              Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding Path}"
              ToolTip="{Binding Path}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,10,0"
                  FontSize="20"
                  Symbol="DocumentPdf24" />
                <StackPanel>
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock
        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
        Text="{loc:Tr Welcome_NoRecentFiles}"
        Visibility="{Binding HasNoRecentFiles, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
