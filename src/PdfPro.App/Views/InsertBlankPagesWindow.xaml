<ui:FluentWindow
  x:Class="PdfPro.App.Views.InsertBlankPagesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:organizer="clr-namespace:PdfPro.App.ViewModels.Organizer"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=organizer:InsertBlankPagesViewModel}"
  Title="{loc:Tr InsertBlank_Title}"
  Width="480"
  MinHeight="0"
  AutomationProperties.AutomationId="InsertBlankPagesWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr InsertBlank_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <TextBlock FontWeight="SemiBold" Text="{loc:Tr InsertBlank_Format}" />
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox
          x:Name="FormatBox"
          AutomationProperties.AutomationId="InsertBlankFormat"
          AutomationProperties.Name="{loc:Tr InsertBlank_Format}"
          DisplayMemberPath="Label"
          ItemsSource="{Binding Formats}"
          SelectedItem="{Binding SelectedFormat}" />
        <TextBlock
          Grid.Column="1"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          AutomationProperties.AutomationId="InsertBlankSize"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding SizeDescription}" />
      </Grid>
      <StackPanel
        Margin="0,6,0,0"
        IsEnabled="{Binding CanChooseOrientation}"
        Orientation="Horizontal">
        <RadioButton
          MinWidth="0"
          Margin="0,0,16,0"
          AutomationProperties.AutomationId="InsertBlankPortrait"
          Content="{loc:Tr InsertBlank_Portrait}"
          GroupName="BlankOrientation"
          IsChecked="{Binding IsPortrait}" />
        <RadioButton
          MinWidth="0"
          AutomationProperties.AutomationId="InsertBlankLandscape"
          Content="{loc:Tr InsertBlank_Landscape}"
          GroupName="BlankOrientation"
          IsChecked="{Binding IsLandscape}" />
      </StackPanel>

      <TextBlock
        Margin="0,16,0,0"
        FontWeight="SemiBold"
        Text="{loc:Tr InsertBlank_Count}" />
      <TextBox
        Width="96"
        Margin="0,6,0,0"
        HorizontalAlignment="Left"
        AutomationProperties.AutomationId="InsertBlankCount"
        AutomationProperties.Name="{loc:Tr InsertBlank_Count}"
        Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />

      <views:InsertPositionPanel Margin="0,16,0,0" DataContext="{Binding Position}" />

      <TextBlock
        Margin="0,12,0,0"
        AutomationProperties.AutomationId="InsertBlankError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding Error}"
        TextWrapping="Wrap"
        Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

      <StackPanel
        Margin="0,20,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="InsertBlankOk"
          Command="{Binding InsertCommand}"
          Content="{loc:Tr Insert_Button}"
          IsDefault="True" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="InsertBlankCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
