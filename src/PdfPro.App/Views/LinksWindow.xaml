<ui:FluentWindow
  x:Class="PdfPro.App.Views.LinksWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:structure="clr-namespace:PdfPro.App.ViewModels.Structure"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=structure:LinksViewModel}"
  Title="{loc:Tr Links_Title}"
  Width="760"
  Height="560"
  MinWidth="600"
  MinHeight="400"
  AutomationProperties.AutomationId="LinksWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar
      Title="{loc:Tr Links_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />
    <StackPanel Grid.Row="1" Margin="24,4,24,8">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />
      <WrapPanel Margin="0,10,0,0">
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.AutomationId="LinksDetect"
          Command="{Binding DetectCommand}"
          Content="{loc:Tr Links_Detect}"
          Icon="{ui:SymbolIcon Wand24}"
          ToolTip="{loc:Tr Links_Detect_ToolTip}" />
        <ui:Button
          AutomationProperties.AutomationId="LinksRemove"
          Command="{Binding RemoveCommand}"
          Content="{loc:Tr Bookmarks_Remove}"
          Icon="{ui:SymbolIcon Delete24}" />
      </WrapPanel>
    </StackPanel>

    <Grid Grid.Row="2" Margin="24,0,24,0">
      <DataGrid
        AutoGenerateColumns="False"
        AutomationProperties.AutomationId="LinksList"
        AutomationProperties.Name="{loc:Tr Links_Title}"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        HeadersVisibility="Column"
        IsReadOnly="True"
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding Selected}"
        SelectionMode="Single">
        <DataGrid.RowStyle>
          <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsNew}" Value="True">
                <Setter Property="FontStyle" Value="Italic" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="Auto"
            Binding="{Binding PageText}"
            Header="{loc:Tr Links_Page}" />
          <DataGridTextColumn
            Width="*"
            Binding="{Binding Text}"
            Header="{loc:Tr Links_Text}" />
          <DataGridTextColumn
            Width="2*"
            Binding="{Binding TargetText}"
            Header="{loc:Tr Links_Target}" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding EmptyText}"
        Visibility="{Binding EmptyText, Converter={StaticResource NullToCollapsed}}" />
      <ui:ProgressRing
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsIndeterminate="True"
        Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Margin="24,12,24,24">
      <TextBlock
        AutomationProperties.AutomationId="LinksStatus"
        Text="{Binding StatusText}"
        TextWrapping="Wrap"
        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock
        Margin="0,4,0,0"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <StackPanel
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="LinksApply"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr Bookmarks_Apply}" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="LinksCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
