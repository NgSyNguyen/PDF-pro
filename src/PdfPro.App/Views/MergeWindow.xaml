<ui:FluentWindow
  x:Class="PdfPro.App.Views.MergeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:dd="urn:gong-wpf-dragdrop"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:merging="clr-namespace:PdfPro.App.ViewModels.Merging"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=merging:MergeViewModel}"
  Title="{loc:Tr Merge_Title}"
  Width="980"
  Height="680"
  MinWidth="760"
  MinHeight="480"
  AutomationProperties.AutomationId="MergeWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <DockPanel>
    <ui:TitleBar
      Title="{loc:Tr Merge_Title}"
      DockPanel.Dock="Top"
      ShowMinimize="False" />

    <!-- Result file and buttons -->
    <Border
      Padding="24,12,24,20"
      BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0"
      DockPanel.Dock="Bottom">
      <StackPanel>
        <DockPanel>
          <TextBlock
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="{loc:Tr Merge_Output_Label}" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="MergePickOutput"
            Command="{Binding PickOutputCommand}"
            Content="{loc:Tr Merge_Output_Pick}"
            DockPanel.Dock="Right" />
          <TextBox
            AutomationProperties.AutomationId="MergeOutput"
            AutomationProperties.Name="{loc:Tr Merge_Output_Label}"
            Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
          <CheckBox
            AutomationProperties.AutomationId="MergeOpenWhenDone"
            Content="{loc:Tr Merge_OpenWhenDone}"
            DockPanel.Dock="Left"
            IsChecked="{Binding OpenWhenDone}" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="MergeCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Common_Cancel}"
            DockPanel.Dock="Right" />
          <ui:Button
            MinWidth="96"
            Margin="8,0,0,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="MergeRun"
            Command="{Binding RunCommand}"
            Content="{loc:Tr Merge_Run}"
            DockPanel.Dock="Right"
            IsDefault="True" />
          <TextBlock
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="MergeSummary"
            DockPanel.Dock="Right"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Grid Margin="24,4,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- The files -->
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            FontWeight="SemiBold"
            Text="{loc:Tr Merge_Files_Header}"
            TextTrimming="CharacterEllipsis" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="MergeSortByName"
            Command="{Binding SortByNameCommand}"
            Content="{loc:Tr Merge_SortByName}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon TextSortAscending24}" />
          <ui:Button
            Appearance="Primary"
            AutomationProperties.AutomationId="MergeAddFiles"
            Command="{Binding AddFilesCommand}"
            Content="{loc:Tr Merge_AddFiles}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon Add24}" />
        </DockPanel>
        <TextBlock
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="MergeError"
          DockPanel.Dock="Bottom"
          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
          Text="{Binding ErrorText}"
          TextWrapping="Wrap"
          Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

        <Grid
          Margin="8,10,8,4"
          DockPanel.Dock="Top"
          TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="112" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Tr Merge_Column_File}" />
          <TextBlock Grid.Column="1" Text="{loc:Tr Merge_Column_Pages}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{loc:Tr Merge_Column_Title}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ListBox
          dd:DragDrop.DropHandler="{Binding}"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          AllowDrop="True"
          AutomationProperties.AutomationId="MergeFiles"
          AutomationProperties.Name="{loc:Tr Merge_Files_Header}"
          HorizontalContentAlignment="Stretch"
          ItemsSource="{Binding Items}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type merging:MergeItemViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="1.2*" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,4,0"
                      Symbol="LockClosed16"
                      ToolTip="{loc:Tr Merge_Encrypted}"
                      Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding FileName}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Source.Path}" />
                  </StackPanel>
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding PageCountText}" />
                </StackPanel>
                <TextBox
                  x:Name="Pages"
                  Grid.Column="1"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="MergeItemPages"
                  AutomationProperties.Name="{loc:Tr Merge_Column_Pages}"
                  Text="{Binding PagesText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox
                  Grid.Column="2"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  AutomationProperties.AutomationId="MergeItemTitle"
                  AutomationProperties.Name="{loc:Tr Merge_Column_Title}"
                  PlaceholderText="{Binding DefaultTitle}"
                  Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel
                  Grid.Column="3"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveUp}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowUp24}"
                    ToolTip="{loc:Tr Merge_MoveUp}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveDown}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowDown24}"
                    ToolTip="{loc:Tr Merge_MoveDown}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.AutomationId="MergeItemRemove"
                    AutomationProperties.Name="{loc:Tr Merge_Remove}"
                    BorderThickness="0"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{loc:Tr Merge_Remove}" />
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasPageError}" Value="True">
                  <Setter TargetName="Pages" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                  <Setter TargetName="Pages" Property="BorderThickness" Value="2" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Options -->
      <StackPanel Grid.Column="2">
        <TextBlock FontWeight="SemiBold" Text="{loc:Tr Merge_Options_Header}" />
        <CheckBox
          Margin="0,10,0,0"
          AutomationProperties.AutomationId="MergeBookmarkPerFile"
          IsChecked="{Binding BookmarkPerFile}">
          <TextBlock Text="{loc:Tr Merge_BookmarkPerFile}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="MergeKeepBookmarks"
          IsChecked="{Binding KeepBookmarks}">
          <TextBlock Text="{loc:Tr Merge_KeepBookmarks}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="MergeTableOfContents"
          IsChecked="{Binding TableOfContents}">
          <TextBlock Text="{loc:Tr Merge_TableOfContents}" TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="MergeStartOnOdd"
          IsChecked="{Binding StartFilesOnOddPages}">
          <TextBlock Text="{loc:Tr Merge_StartOnOdd}" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock
          Margin="0,16,0,4"
          FontWeight="SemiBold"
          Text="{loc:Tr Merge_PageSize_Label}" />
        <ComboBox
          AutomationProperties.AutomationId="MergePageSize"
          AutomationProperties.Name="{loc:Tr Merge_PageSize_Label}"
          DisplayMemberPath="Label"
          ItemsSource="{Binding PageSizes}"
          SelectedItem="{Binding PageSize}" />
      </StackPanel>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
