<ui:FluentWindow
  x:Class="PdfPro.App.Views.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
  Title="{loc:Tr About_Title}"
  Width="720"
  Height="640"
  AutomationProperties.AutomationId="AboutWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Tr About_Title}" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="16,8,16,0" Orientation="Horizontal">
      <ui:SymbolIcon FontSize="48" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="DocumentPdf24" />
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <ui:TextBlock FontTypography="Subtitle" Text="{Binding Product}" />
        <TextBlock AutomationProperties.AutomationId="AboutVersion" Text="{Binding Version}" />
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr About_NoTelemetry}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="16,12,16,0">
      <TextBox
        AutomationProperties.AutomationId="AboutDetails"
        AutomationProperties.Name="{loc:Tr About_Details}"
        IsReadOnly="True"
        Text="{Binding Details, Mode=OneWay}"
        TextWrapping="Wrap" />
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
        <ui:Button AutomationProperties.AutomationId="AboutCopy" Command="{Binding CopyDetailsCommand}" Content="{loc:Tr About_Copy}" Icon="{ui:SymbolIcon Copy24}" />
        <ui:Button Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}" Content="{loc:Tr Error_OpenLogFolder}" Icon="{ui:SymbolIcon DocumentBulletList24}" />
        <ui:Button
          Margin="8,0,0,0"
          AutomationProperties.AutomationId="AboutCheckUpdates"
          Command="{Binding CheckForUpdatesCommand}"
          Content="{loc:Tr Update_Check}"
          Icon="{ui:SymbolIcon ArrowSync24}"
          Visibility="{Binding CanCheckForUpdates, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Text="{Binding CopyStatus}" />
      </StackPanel>
      <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="{loc:Tr About_Licenses}" />
    </StackPanel>

    <TextBox
      Grid.Row="3"
      Margin="16,0"
      AutomationProperties.AutomationId="AboutNotices"
      AutomationProperties.Name="{loc:Tr About_Licenses}"
      FontFamily="Consolas, Segoe UI"
      FontSize="12"
      HorizontalScrollBarVisibility="Disabled"
      IsReadOnly="True"
      Text="{Binding Notices, Mode=OneWay}"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto" />

    <ui:Button
      Grid.Row="4"
      Margin="16"
      HorizontalAlignment="Right"
      Command="{Binding CloseCommand}"
      Content="{loc:Tr Common_Close}"
      IsCancel="True"
      IsDefault="True" />
  </Grid>
</ui:FluentWindow>
