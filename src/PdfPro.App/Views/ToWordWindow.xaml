<ui:FluentWindow
  x:Class="PdfPro.App.Views.ToWordWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converting="clr-namespace:PdfPro.App.ViewModels.Converting"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=converting:ToWordViewModel}"
  Title="{loc:Tr ToWord_Title}"
  Width="520"
  MinHeight="0"
  AutomationProperties.AutomationId="ToWordWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr ToWord_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />

      <views:PageTargetPanel Margin="0,16,0,0" DataContext="{Binding Target}" />

      <CheckBox
        Margin="0,16,0,0"
        AutomationProperties.AutomationId="ToWordTables"
        IsChecked="{Binding Tables}">
        <StackPanel>
          <TextBlock Text="{loc:Tr ToWord_Tables}" />
          <TextBlock
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr ToWord_Tables_Details}"
            TextWrapping="Wrap" />
        </StackPanel>
      </CheckBox>
      <CheckBox
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="ToWordPictures"
        Content="{loc:Tr ToWord_Pictures}"
        IsChecked="{Binding Pictures}" />
      <CheckBox
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="ToWordOpenWhenDone"
        Content="{loc:Tr ToWord_OpenWhenDone}"
        IsChecked="{Binding OpenWhenDone}" />

      <TextBlock
        Margin="0,16,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr ToWord_Note}"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="ToWordError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

      <StackPanel
        Margin="0,20,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="ToWordRun"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr ToWord_Run}"
          IsDefault="True" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="ToWordCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}"
          IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
