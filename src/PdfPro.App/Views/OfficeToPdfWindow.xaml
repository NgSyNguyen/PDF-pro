<ui:FluentWindow
  x:Class="PdfPro.App.Views.OfficeToPdfWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converting="clr-namespace:PdfPro.App.ViewModels.Converting"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dd="urn:gong-wpf-dragdrop"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=converting:OfficeToPdfViewModel}"
  Title="{loc:Tr OfficeToPdf_Title}"
  Width="760"
  Height="600"
  MinWidth="600"
  MinHeight="460"
  AutomationProperties.AutomationId="OfficeToPdfWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <DockPanel>
    <ui:TitleBar
      Title="{loc:Tr OfficeToPdf_Title}"
      DockPanel.Dock="Top"
      ShowMaximize="False"
      ShowMinimize="False" />

    <!-- Where the PDFs go -->
    <StackPanel Margin="24,0,24,20" DockPanel.Dock="Bottom">
      <TextBlock
        Margin="0,0,0,8"
        AutomationProperties.AutomationId="OfficeToPdfError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock
        Margin="0,0,0,4"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr OfficeToPdf_Folder}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          AutomationProperties.AutomationId="OfficeToPdfFolder"
          AutomationProperties.Name="{loc:Tr OfficeToPdf_Folder}"
          Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button
          Grid.Column="1"
          Margin="8,0,0,0"
          AutomationProperties.AutomationId="OfficeToPdfPickFolder"
          Command="{Binding PickFolderCommand}"
          Content="{loc:Tr Split_Folder_Pick}" />
      </Grid>
      <CheckBox
        Margin="0,10,0,0"
        AutomationProperties.AutomationId="OfficeToPdfOverwrite"
        Content="{loc:Tr OfficeToPdf_Overwrite}"
        IsChecked="{Binding Overwrite}" />
      <DockPanel Margin="0,8,0,0">
        <CheckBox
          AutomationProperties.AutomationId="OfficeToPdfOpenWhenDone"
          Content="{loc:Tr OfficeToPdf_OpenWhenDone}"
          DockPanel.Dock="Left"
          IsChecked="{Binding OpenWhenDone}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button
            MinWidth="96"
            Margin="0,0,8,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="OfficeToPdfRun"
            Command="{Binding RunCommand}"
            Content="{loc:Tr OfficeToPdf_Run}"
            IsDefault="True" />
          <ui:Button
            MinWidth="96"
            AutomationProperties.AutomationId="OfficeToPdfCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Common_Cancel}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- The documents -->
    <DockPanel Margin="24,4,24,12">
      <DockPanel DockPanel.Dock="Top" LastChildFill="False">
        <TextBlock
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          FontWeight="SemiBold"
          Text="{loc:Tr OfficeToPdf_Files_Header}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          AutomationProperties.AutomationId="OfficeToPdfSummary"
          DockPanel.Dock="Left"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding SummaryText}" />
        <ui:Button
          Appearance="Primary"
          AutomationProperties.AutomationId="OfficeToPdfAddFiles"
          Command="{Binding AddFilesCommand}"
          Content="{loc:Tr OfficeToPdf_AddFiles}"
          DockPanel.Dock="Right"
          Icon="{ui:SymbolIcon Add24}" />
      </DockPanel>

      <TextBlock
        Margin="0,10,0,0"
        AutomationProperties.AutomationId="OfficeToPdfLibreOffice"
        DockPanel.Dock="Bottom"
        FontSize="12"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding LibreOfficeText}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding LibreOfficeText}" />
      <TextBlock
        Margin="0,10,0,0"
        DockPanel.Dock="Bottom"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr OfficeToPdf_Note}"
        TextWrapping="Wrap" />

      <ListBox
        Margin="0,10,0,0"
        dd:DragDrop.DropHandler="{Binding}"
        dd:DragDrop.IsDropTarget="True"
        AllowDrop="True"
        AutomationProperties.AutomationId="OfficeToPdfFiles"
        AutomationProperties.Name="{loc:Tr OfficeToPdf_Files_Header}"
        HorizontalContentAlignment="Stretch"
        ItemsSource="{Binding Items}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
            <Setter Property="Padding" Value="8,4" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type converting:OfficeFileItemViewModel}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock
                  FontWeight="SemiBold"
                  Text="{Binding FileName}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding Path}" />
                <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding SizeText}" />
              </StackPanel>
              <ui:Button
                Grid.Column="1"
                Padding="6"
                Appearance="Transparent"
                AutomationProperties.AutomationId="OfficeToPdfItemRemove"
                AutomationProperties.Name="{loc:Tr Merge_Remove}"
                BorderThickness="0"
                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                CommandParameter="{Binding}"
                Icon="{ui:SymbolIcon Dismiss24}"
                ToolTip="{loc:Tr Merge_Remove}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</ui:FluentWindow>
