<ui:FluentWindow
  x:Class="PdfPro.App.Views.ShortcutsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:PdfPro.App.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=vm:ShortcutsViewModel}"
  Title="{loc:Tr Shortcuts_Title}"
  Width="620"
  Height="640"
  AutomationProperties.AutomationId="ShortcutsWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    <KeyBinding Key="F1" Command="{Binding CloseCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Tr Shortcuts_Title}" ShowMaximize="False" ShowMinimize="False" />

    <ScrollViewer
      Grid.Row="1"
      Margin="16,8,16,0"
      AutomationProperties.AutomationId="ShortcutsList"
      Focusable="True"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ShortcutGroup}">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Text="{Binding Header}" />
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ShortcutEntry}">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border
                        Padding="6,2"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock FontFamily="Consolas, Segoe UI" Text="{Binding Keys}" TextWrapping="Wrap" />
                      </Border>
                      <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Action}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <ui:Button
      Grid.Row="2"
      Margin="16"
      HorizontalAlignment="Right"
      AutomationProperties.AutomationId="ShortcutsClose"
      Command="{Binding CloseCommand}"
      Content="{loc:Tr Common_Close}"
      IsCancel="True"
      IsDefault="True" />
  </Grid>
</ui:FluentWindow>
