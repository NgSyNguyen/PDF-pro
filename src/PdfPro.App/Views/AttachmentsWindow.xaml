<ui:FluentWindow
  x:Class="PdfPro.App.Views.AttachmentsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:extracting="clr-namespace:PdfPro.App.ViewModels.Extracting"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=extracting:AttachmentsViewModel}"
  Title="{loc:Tr Attachments_Title}"
  Width="640"
  Height="560"
  MinWidth="520"
  MinHeight="400"
  AutomationProperties.AutomationId="AttachmentsWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
  </ui:FluentWindow.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar
      Title="{loc:Tr Attachments_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,4,24,8">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />
      <WrapPanel Margin="0,10,0,0">
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.AutomationId="AttachmentsOpen"
          Command="{Binding OpenCommand}"
          Content="{loc:Tr Attachments_Open}"
          Icon="{ui:SymbolIcon Eye24}"
          ToolTip="{loc:Tr Attachments_Open_ToolTip}" />
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.AutomationId="AttachmentsSave"
          Command="{Binding SaveCommand}"
          Content="{loc:Tr Attachments_Save}"
          Icon="{ui:SymbolIcon ArrowDownload24}" />
        <ui:Button
          Margin="0,0,8,0"
          AutomationProperties.AutomationId="AttachmentsAdd"
          Command="{Binding AddCommand}"
          Content="{loc:Tr Attachments_Add}"
          Icon="{ui:SymbolIcon Add24}" />
        <ui:Button
          AutomationProperties.AutomationId="AttachmentsRemove"
          Command="{Binding RemoveCommand}"
          Content="{loc:Tr Attachments_Remove}"
          Icon="{ui:SymbolIcon Delete24}" />
      </WrapPanel>
    </StackPanel>

    <Grid Grid.Row="2" Margin="24,0,24,0">
      <ListBox
        AutomationProperties.AutomationId="AttachmentsList"
        AutomationProperties.Name="{loc:Tr Attachments_Title}"
        ItemsSource="{Binding Items}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type extracting:AttachmentItemViewModel}">
            <StackPanel Margin="0,4">
              <TextBlock
                FontWeight="SemiBold"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
              <TextBlock
                Text="{Binding Description}"
                TextWrapping="Wrap"
                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
              <TextBox
                Margin="0,4,0,0"
                AutomationProperties.Name="{loc:Tr Attachments_Description}"
                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        AutomationProperties.AutomationId="AttachmentsEmpty"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding EmptyText}"
        Visibility="{Binding EmptyText, Converter={StaticResource NullToCollapsed}}" />
      <ui:ProgressRing
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsIndeterminate="True"
        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <StackPanel Grid.Row="3" Margin="24,12,24,24">
      <TextBlock
        AutomationProperties.AutomationId="AttachmentsStatus"
        Text="{Binding StatusText}"
        TextWrapping="Wrap"
        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock
        Margin="0,4,0,0"
        AutomationProperties.AutomationId="AttachmentsError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <StackPanel
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="AttachmentsApply"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr Attachments_Apply}" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="AttachmentsClose"
          Command="{Binding CloseCommand}"
          Content="{loc:Tr Common_Close}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
