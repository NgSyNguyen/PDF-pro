<ui:FluentWindow
  x:Class="PdfPro.App.Views.FromImagesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converting="clr-namespace:PdfPro.App.ViewModels.Converting"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:dd="urn:gong-wpf-dragdrop"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=converting:FromImagesViewModel}"
  Title="{loc:Tr FromImages_Title}"
  Width="900"
  Height="640"
  MinWidth="720"
  MinHeight="480"
  AutomationProperties.AutomationId="FromImagesWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <DockPanel>
    <ui:TitleBar
      Title="{loc:Tr FromImages_Title}"
      DockPanel.Dock="Top"
      ShowMaximize="False"
      ShowMinimize="False" />

    <!-- The PDF to write -->
    <StackPanel Margin="24,0,24,20" DockPanel.Dock="Bottom">
      <TextBlock
        Margin="0,0,0,8"
        AutomationProperties.AutomationId="FromImagesError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock
        Margin="0,0,0,4"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr FromImages_Output}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          AutomationProperties.AutomationId="FromImagesOutput"
          AutomationProperties.Name="{loc:Tr FromImages_Output}"
          Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button
          Grid.Column="1"
          Margin="8,0,0,0"
          AutomationProperties.AutomationId="FromImagesPickOutput"
          Command="{Binding PickOutputCommand}"
          Content="{loc:Tr Split_Folder_Pick}" />
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <CheckBox
          AutomationProperties.AutomationId="FromImagesOpenWhenDone"
          Content="{loc:Tr FromImages_OpenWhenDone}"
          DockPanel.Dock="Left"
          IsChecked="{Binding OpenWhenDone}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button
            MinWidth="96"
            Margin="0,0,8,0"
            Appearance="Primary"
            AutomationProperties.AutomationId="FromImagesRun"
            Command="{Binding RunCommand}"
            Content="{loc:Tr FromImages_Run}"
            IsDefault="True" />
          <ui:Button
            MinWidth="96"
            AutomationProperties.AutomationId="FromImagesCancel"
            Command="{Binding CancelCommand}"
            Content="{loc:Tr Common_Cancel}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid Margin="24,4,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>

      <!-- The pictures -->
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
          <TextBlock
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            FontWeight="SemiBold"
            Text="{loc:Tr FromImages_Files_Header}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="FromImagesSummary"
            DockPanel.Dock="Left"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding SummaryText}" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="FromImagesSortByName"
            Command="{Binding SortByNameCommand}"
            Content="{loc:Tr Merge_SortByName}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon TextSortAscending24}" />
          <ui:Button
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="FromImagesAddFolder"
            Command="{Binding AddFolderCommand}"
            Content="{loc:Tr FromImages_AddFolder}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon FolderAdd24}" />
          <ui:Button
            Appearance="Primary"
            AutomationProperties.AutomationId="FromImagesAddFiles"
            Command="{Binding AddFilesCommand}"
            Content="{loc:Tr FromImages_AddFiles}"
            DockPanel.Dock="Right"
            Icon="{ui:SymbolIcon Add24}" />
        </DockPanel>

        <ListBox
          Margin="0,10,0,0"
          dd:DragDrop.DropHandler="{Binding}"
          dd:DragDrop.IsDragSource="True"
          dd:DragDrop.IsDropTarget="True"
          dd:DragDrop.UseDefaultDragAdorner="True"
          AllowDrop="True"
          AutomationProperties.AutomationId="FromImagesFiles"
          AutomationProperties.Name="{loc:Tr FromImages_Files_Header}"
          HorizontalContentAlignment="Stretch"
          ItemsSource="{Binding Items}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type converting:FromImagesItemViewModel}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Path}" />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SizeText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveUp}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowUp24}"
                    ToolTip="{loc:Tr Merge_MoveUp}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr Merge_MoveDown}"
                    BorderThickness="0"
                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon ArrowDown24}"
                    ToolTip="{loc:Tr Merge_MoveDown}" />
                  <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    AutomationProperties.AutomationId="FromImagesItemRemove"
                    AutomationProperties.Name="{loc:Tr Merge_Remove}"
                    BorderThickness="0"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{loc:Tr Merge_Remove}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Page size -->
      <StackPanel Grid.Column="2">
        <TextBlock FontWeight="SemiBold" Text="{loc:Tr FromImages_PageSize}" />
        <RadioButton
          Margin="0,10,0,0"
          AutomationProperties.AutomationId="FromImagesFitImage"
          GroupName="FromImagesPageSize"
          IsChecked="{Binding IsFitImage}">
          <StackPanel>
            <TextBlock Text="{loc:Tr FromImages_FitImage}" />
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{loc:Tr FromImages_FitImage_Details}"
              TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="FromImagesA4Fit"
          GroupName="FromImagesPageSize"
          IsChecked="{Binding IsA4Fit}">
          <StackPanel>
            <TextBlock Text="{loc:Tr FromImages_A4Fit}" />
            <TextBlock
              FontSize="12"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{loc:Tr FromImages_A4Fit_Details}"
              TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <RadioButton
          Margin="0,8,0,0"
          AutomationProperties.AutomationId="FromImagesA4Margins"
          Content="{loc:Tr FromImages_A4Margins}"
          GroupName="FromImagesPageSize"
          IsChecked="{Binding IsA4Margins}" />
        <StackPanel
          Margin="28,6,0,0"
          Orientation="Horizontal"
          Visibility="{Binding IsA4Margins, Converter={StaticResource BoolToVisibility}}">
          <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Text="{loc:Tr FromImages_Margin}" />
          <TextBox
            Width="72"
            AutomationProperties.AutomationId="FromImagesMargin"
            AutomationProperties.Name="{loc:Tr FromImages_Margin}"
            Text="{Binding MarginText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock
          Margin="0,16,0,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{loc:Tr FromImages_Note}"
          TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</ui:FluentWindow>
