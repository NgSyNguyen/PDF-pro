<ui:FluentWindow
  x:Class="PdfPro.App.Views.ToTextWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converting="clr-namespace:PdfPro.App.ViewModels.Converting"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=converting:ToTextViewModel}"
  Title="{loc:Tr ToText_Title}"
  Width="560"
  MinHeight="0"
  AutomationProperties.AutomationId="ToTextWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </ui:FluentWindow.Resources>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr ToText_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <StackPanel Margin="24,4,24,24">
      <TextBlock
        FontWeight="SemiBold"
        Text="{Binding FileName}"
        TextTrimming="CharacterEllipsis" />

      <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr ToImages_Format}" />
      <RadioButton
        AutomationProperties.AutomationId="ToTextPlain"
        GroupName="ToTextFormat"
        IsChecked="{Binding IsText}">
        <StackPanel>
          <TextBlock Text="{loc:Tr ToText_Plain}" />
          <TextBlock
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr ToText_Plain_Details}"
            TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>
      <RadioButton
        Margin="0,6,0,0"
        AutomationProperties.AutomationId="ToTextMarkdown"
        GroupName="ToTextFormat"
        IsChecked="{Binding IsMarkdown}">
        <StackPanel>
          <TextBlock Text="{loc:Tr ToText_Markdown}" />
          <TextBlock
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr ToText_Markdown_Details}"
            TextWrapping="Wrap" />
        </StackPanel>
      </RadioButton>

      <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr ToText_Split}" />
      <RadioButton
        AutomationProperties.AutomationId="ToTextPageBreaks"
        Content="{loc:Tr ToText_PageBreaks}"
        GroupName="ToTextSplit"
        IsChecked="{Binding IsPageBreaks}" />
      <RadioButton
        Margin="0,4,0,0"
        AutomationProperties.AutomationId="ToTextOneFile"
        Content="{loc:Tr ToText_OneFile}"
        GroupName="ToTextSplit"
        IsChecked="{Binding IsOneFile}" />
      <RadioButton
        Margin="0,4,0,0"
        AutomationProperties.AutomationId="ToTextFilePerPage"
        Content="{loc:Tr ToText_FilePerPage}"
        GroupName="ToTextSplit"
        IsChecked="{Binding IsFilePerPage}" />

      <views:PageTargetPanel Margin="0,16,0,0" DataContext="{Binding Target}" />

      <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr ToImages_Folder}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
          AutomationProperties.AutomationId="ToTextFolder"
          AutomationProperties.Name="{loc:Tr ToImages_Folder}"
          Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button
          Grid.Column="1"
          Margin="8,0,0,0"
          AutomationProperties.AutomationId="ToTextPickFolder"
          Command="{Binding PickFolderCommand}"
          Content="{loc:Tr Split_Folder_Pick}" />
      </Grid>
      <TextBlock
        Margin="0,6,0,0"
        AutomationProperties.AutomationId="ToTextNames"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding NamesText}"
        TextTrimming="CharacterEllipsis" />
      <WrapPanel Margin="0,8,0,0">
        <CheckBox
          Margin="0,0,16,0"
          AutomationProperties.AutomationId="ToTextOverwrite"
          Content="{loc:Tr Split_Overwrite}"
          IsChecked="{Binding Overwrite}" />
        <CheckBox
          AutomationProperties.AutomationId="ToTextOpenFolder"
          Content="{loc:Tr Split_OpenFolder}"
          IsChecked="{Binding OpenFolderWhenDone}" />
      </WrapPanel>

      <TextBlock
        Margin="0,12,0,0"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr ToText_Note}"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,8,0,0"
        AutomationProperties.AutomationId="ToTextError"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        Text="{Binding ErrorText}"
        TextWrapping="Wrap"
        Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />

      <StackPanel
        Margin="0,20,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Margin="0,0,8,0"
          Appearance="Primary"
          AutomationProperties.AutomationId="ToTextApply"
          Command="{Binding ApplyCommand}"
          Content="{loc:Tr ToText_Apply}"
          IsDefault="True" />
        <ui:Button
          MinWidth="96"
          AutomationProperties.AutomationId="ToTextCancel"
          Command="{Binding CancelCommand}"
          Content="{loc:Tr Common_Cancel}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
