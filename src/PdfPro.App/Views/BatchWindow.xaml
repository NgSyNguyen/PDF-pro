<ui:FluentWindow
  x:Class="PdfPro.App.Views.BatchWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:automation="clr-namespace:PdfPro.App.ViewModels.Automation"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=automation:BatchViewModel}"
  Title="{loc:Tr Batch_Title}"
  Width="1000"
  Height="680"
  MinWidth="780"
  MinHeight="480"
  AutomationProperties.AutomationId="BatchWindow"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{loc:Tr Batch_Title}" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,4,24,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Tr Batch_Job}" />
        <ComboBox
          Grid.Column="1"
          AutomationProperties.AutomationId="BatchJob"
          AutomationProperties.Name="{loc:Tr Batch_Job}"
          DisplayMemberPath="Name"
          IsEnabled="{Binding IsIdle}"
          ItemsSource="{Binding Jobs}"
          SelectedItem="{Binding Job}" />
      </Grid>
      <WrapPanel Margin="0,10,0,0">
        <ui:Button Margin="0,0,8,6" AutomationProperties.AutomationId="BatchAddFiles" Command="{Binding AddFilesCommand}" Content="{loc:Tr Batch_AddFiles}" Icon="{ui:SymbolIcon DocumentAdd24}" />
        <ui:Button Margin="0,0,8,6" AutomationProperties.AutomationId="BatchAddFolder" Command="{Binding AddFolderCommand}" Content="{loc:Tr Batch_AddFolder}" Icon="{ui:SymbolIcon FolderAdd24}" />
        <CheckBox Margin="0,0,12,6" VerticalAlignment="Center" Content="{loc:Tr Batch_Recursive}" IsChecked="{Binding Recursive}" />
        <TextBlock Margin="0,0,6,6" VerticalAlignment="Center" Text="{loc:Tr Batch_Pattern}" />
        <ui:TextBox Width="140" Margin="0,0,12,6" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button Margin="0,0,8,6" Command="{Binding ClearCommand}" Content="{loc:Tr Batch_Clear}" />
      </WrapPanel>
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="{loc:Tr Batch_Output}" />
        <ui:TextBox Grid.Column="1" AutomationProperties.AutomationId="BatchOutput" PlaceholderText="{loc:Tr Batch_Output_Placeholder}" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button Grid.Column="2" Margin="8,0,16,0" Command="{Binding PickOutputFolderCommand}" Content="{loc:Tr Batch_Browse}" />
        <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Batch_Parallel}" />
        <ui:TextBox Grid.Column="4" Width="70" AutomationProperties.Name="{loc:Tr Batch_Parallel}" Text="{Binding Parallel, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </StackPanel>

    <DataGrid
      Grid.Row="2"
      Margin="24,0,24,8"
      AutoGenerateColumns="False"
      AutomationProperties.AutomationId="BatchRows"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      HeadersVisibility="Column"
      IsReadOnly="True"
      ItemsSource="{Binding Rows}">
      <DataGrid.Columns>
        <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="{loc:Tr Batch_Column_File}" />
        <DataGridTextColumn Width="1.2*" Binding="{Binding Folder}" Header="{loc:Tr Batch_Column_Folder}" />
        <DataGridTextColumn Width="110" Binding="{Binding StatusText}" Header="{loc:Tr Batch_Column_Status}" />
        <DataGridTextColumn Width="3*" Binding="{Binding Detail}" Header="{loc:Tr Batch_Column_Detail}" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" Margin="24,0,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ProgressBar Height="4" Margin="0,0,0,8" Maximum="1" Value="{Binding Fraction}" />
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" AutomationProperties.AutomationId="BatchSummary" Text="{Binding Summary}" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding ExportLogCommand}" Content="{loc:Tr Batch_ExportLog}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding RerunFailedCommand}" Content="{loc:Tr Batch_RerunFailed}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding PauseCommand}" Content="{loc:Tr Batch_Pause}" />
          <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="{loc:Tr Batch_Cancel}" />
          <ui:Button Margin="0,0,8,0" Appearance="Primary" AutomationProperties.AutomationId="BatchStart" Command="{Binding StartCommand}" Content="{loc:Tr Batch_Start}" />
          <ui:Button Command="{Binding CloseCommand}" Content="{loc:Tr Common_Close}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
