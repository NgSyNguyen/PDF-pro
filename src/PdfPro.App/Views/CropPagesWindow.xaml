<ui:FluentWindow
  x:Class="PdfPro.App.Views.CropPagesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:loc="clr-namespace:PdfPro.App.Localization"
  xmlns:organizer="clr-namespace:PdfPro.App.ViewModels.Organizer"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:views="clr-namespace:PdfPro.App.Views"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance Type=organizer:CropPagesViewModel}"
  Title="{loc:Tr Crop_Title}"
  Width="760"
  MinHeight="0"
  AutomationProperties.AutomationId="CropPagesWindow"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <Style x:Key="MarginBox" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
      <Setter Property="Width" Value="88" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="IsEnabled" Value="{Binding CanEditMargins}" />
    </Style>
  </ui:FluentWindow.Resources>

  <StackPanel>
    <ui:TitleBar
      Title="{loc:Tr Crop_Title}"
      ShowMaximize="False"
      ShowMinimize="False" />

    <Grid Margin="24,4,24,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="{loc:Tr Crop_Margins}" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Crop_Left}" />
          <TextBox
            x:Name="LeftBox"
            Grid.Column="1"
            AutomationProperties.AutomationId="CropLeft"
            AutomationProperties.Name="{loc:Tr Crop_Left}"
            Style="{StaticResource MarginBox}"
            Text="{Binding LeftText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Crop_Top}" />
          <TextBox
            Grid.Column="4"
            AutomationProperties.AutomationId="CropTop"
            AutomationProperties.Name="{loc:Tr Crop_Top}"
            Style="{StaticResource MarginBox}"
            Text="{Binding TopText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="2" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Crop_Right}" />
          <TextBox
            Grid.Row="2"
            Grid.Column="1"
            AutomationProperties.AutomationId="CropRight"
            AutomationProperties.Name="{loc:Tr Crop_Right}"
            Style="{StaticResource MarginBox}"
            Text="{Binding RightText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="{loc:Tr Crop_Bottom}" />
          <TextBox
            Grid.Row="2"
            Grid.Column="4"
            AutomationProperties.AutomationId="CropBottom"
            AutomationProperties.Name="{loc:Tr Crop_Bottom}"
            Style="{StaticResource MarginBox}"
            Text="{Binding BottomText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <CheckBox
          Margin="0,10,0,0"
          AutomationProperties.AutomationId="CropUniform"
          Content="{loc:Tr Crop_Uniform}"
          IsChecked="{Binding IsUniform}"
          IsEnabled="{Binding CanEditMargins}" />
        <CheckBox
          Margin="0,4,0,0"
          AutomationProperties.AutomationId="CropReset"
          Content="{loc:Tr Crop_Reset}"
          IsChecked="{Binding IsReset}" />

        <views:PageTargetPanel Margin="0,16,0,0" DataContext="{Binding Target}" />

        <TextBlock
          Margin="0,12,0,0"
          AutomationProperties.AutomationId="CropError"
          Foreground="{DynamicResource SystemFillColorCriticalBrush}"
          Text="{Binding Error}"
          TextWrapping="Wrap"
          Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>

      <!-- Preview: the first chosen page as displayed, the part that will be cut shaded. -->
      <StackPanel Grid.Column="2">
        <TextBlock
          Margin="0,0,0,8"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{loc:Tr Crop_Preview}" />
        <Border
          Width="300"
          Height="380"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          CornerRadius="4">
          <Grid
            Width="{Binding PreviewWidth}"
            Height="{Binding PreviewHeight}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="CropPreview"
            Background="White"
            ClipToBounds="True">
            <Image
              RenderOptions.BitmapScalingMode="HighQuality"
              Source="{Binding PreviewImage}"
              Stretch="Fill">
              <Image.LayoutTransform>
                <RotateTransform Angle="{Binding PreviewAngle}" />
              </Image.LayoutTransform>
            </Image>
            <Canvas IsHitTestVisible="False">
              <Rectangle Fill="#80000000" Width="{Binding PreviewWidth}" Height="{Binding KeptTop}" />
              <Rectangle
                Canvas.Top="{Binding KeptBottom}"
                Width="{Binding PreviewWidth}"
                Height="{Binding ShadeBottomHeight}"
                Fill="#80000000" />
              <Rectangle
                Canvas.Top="{Binding KeptTop}"
                Width="{Binding KeptLeft}"
                Height="{Binding KeptHeight}"
                Fill="#80000000" />
              <Rectangle
                Canvas.Left="{Binding KeptRight}"
                Canvas.Top="{Binding KeptTop}"
                Width="{Binding ShadeRightWidth}"
                Height="{Binding KeptHeight}"
                Fill="#80000000" />
              <Rectangle
                Canvas.Left="{Binding KeptLeft}"
                Canvas.Top="{Binding KeptTop}"
                Width="{Binding KeptWidth}"
                Height="{Binding KeptHeight}"
                Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                StrokeDashArray="4 2"
                StrokeThickness="1.5" />
            </Canvas>
          </Grid>
        </Border>
        <TextBlock
          Margin="0,6,0,0"
          HorizontalAlignment="Center"
          AutomationProperties.AutomationId="CropPreviewSize"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding PreviewSize}" />
        <TextBlock
          MaxWidth="300"
          Margin="0,4,0,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{loc:Tr Crop_PreviewHint}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
      </StackPanel>

    </Grid>

    <StackPanel
      Margin="24,0,24,24"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <ui:Button
        MinWidth="96"
        Margin="0,0,8,0"
        Appearance="Primary"
        AutomationProperties.AutomationId="CropOk"
        Command="{Binding ApplyCommand}"
        Content="{loc:Tr Crop_Apply}"
        IsDefault="True" />
      <ui:Button
        MinWidth="96"
        AutomationProperties.AutomationId="CropCancel"
        Command="{Binding CancelCommand}"
        Content="{loc:Tr Common_Cancel}" />
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
