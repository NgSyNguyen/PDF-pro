<Application
  x:Class="PdfPro.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:PdfPro.App.Controls"
  ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The real theme is applied at startup from the user's settings (AppThemeService). -->
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <controls:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" IsInverted="True" />
      <controls:NullToCollapsedConverter x:Key="NullToCollapsed" />
      <controls:EnumMatchConverter x:Key="EnumMatch" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
