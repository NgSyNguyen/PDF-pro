<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF is used only to read/write the golden PNG files; the code under test stays UI-independent. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfPro.Pdfium\PdfPro.Pdfium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Golden\*.png" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
